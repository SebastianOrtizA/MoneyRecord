<Project Sdk="Microsoft.NET.Sdk">

	<!-- Domain code with no MAUI dependency: models, helpers, SQLite repositories, migrations, business services and
	     the localized strings. The app and the tests both reference it; the tests run on plain net10.0 (Linux too). -->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>MoneyRecord</RootNamespace>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<!-- Bank statement import (CSV); dual MS-PL / Apache-2.0, used under Apache-2.0 -->
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
		<!-- PDF report (MigraDoc, the platform-independent "Core" build). Pinned: 6.2.4 is the last MIT version; 6.5.0 and
		     7.0.0-preview-2 are AGPL-3.0-only -->
		<PackageReference Include="PDFsharp-MigraDoc" Version="6.2.4" />
		<!-- PDFsharp's own dependency (8.0.1, for signatures we don't use) has known advisories (NU1902 / NU1903) -->
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
		<PackageReference Include="SharpZipLib" Version="1.4.2" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
		<!-- SQLite3 Multiple Ciphers: SQLite with encryption (see SqliteSetup). sqlite-net-pcl still brings plain SQLite
		     (e_sqlite3), which its static constructor needs; the two SQLitePCLRaw packages are pinned to the bundle's 3.0.x. -->
		<PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.6.1" />
		<PackageReference Include="SQLitePCLRaw.core" Version="3.0.5" />
		<PackageReference Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
	</ItemGroup>

	<ItemGroup>
		<!-- The PDF report's fonts: the app's Open Sans, embedded (PdfFonts) -->
		<EmbeddedResource Include="..\MoneyRecord\Resources\Fonts\OpenSans-Regular.ttf" LogicalName="MoneyRecord.Fonts.OpenSans-Regular.ttf" Link="Resources\Fonts\OpenSans-Regular.ttf" />
		<EmbeddedResource Include="..\MoneyRecord\Resources\Fonts\OpenSans-Semibold.ttf" LogicalName="MoneyRecord.Fonts.OpenSans-Semibold.ttf" Link="Resources\Fonts\OpenSans-Semibold.ttf" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Resources\Strings\AppResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>AppResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<!-- Public: the app's views and view models use AppResources directly -->
		<EmbeddedResource Update="Resources\Strings\AppResources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>AppResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
		<EmbeddedResource Update="Resources\Strings\AppResources.*.resx">
			<DependentUpon>AppResources.resx</DependentUpon>
		</EmbeddedResource>
	</ItemGroup>

</Project>
