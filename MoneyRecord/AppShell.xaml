<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MoneyRecord.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MoneyRecord.Views"
    xmlns:ext="clr-namespace:MoneyRecord.Extensions"
    Title="MoneyRecord"
    FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
    Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
    Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
    Shell.TabBarUnselectedColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}">

    <!-- Tabs and their pages keep implicit routes, so each page is a root at //PageRoute (NavigationHistory) -->
    <TabBar>
        <Tab Title="{ext:Localize Home}">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF02DC;" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        </Tab>

        <Tab Title="{ext:Localize Transactions}">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF0279;" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:TransactionsPage}" Route="TransactionsPage" />
        </Tab>

        <!-- Three report pages as top tabs until the Reports hub (8.7) -->
        <Tab Title="{ext:Localize Reports}">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF0128;" />
            </Tab.Icon>
            <ShellContent Title="{ext:Localize Expenses}"
                          ContentTemplate="{DataTemplate views:ExpenseReportPage}"
                          Route="ExpenseReportPage" />
            <ShellContent Title="{ext:Localize Incomes}"
                          ContentTemplate="{DataTemplate views:IncomeReportPage}"
                          Route="IncomeReportPage" />
            <ShellContent Title="{ext:Localize Trends}"
                          ContentTemplate="{DataTemplate views:TrendsReportPage}"
                          Route="TrendsReportPage" />
        </Tab>

        <Tab Title="{ext:Localize Budgets}">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF0584;" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:BudgetPage}" Route="BudgetPage" />
        </Tab>

        <Tab Title="{ext:Localize More}">
            <Tab.Icon>
                <FontImageSource FontFamily="MaterialDesignIcons" Glyph="&#xF01D8;" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:MorePage}" Route="MorePage" />
        </Tab>
    </TabBar>

</Shell>
