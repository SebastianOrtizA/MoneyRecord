<?xml version="1.0" encoding="utf-8" ?>
<!-- One scheduled occurrence (Home's Upcoming card, the Recurring page): icon, description, when, signed amount -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             x:Class="MoneyRecord.Controls.UpcomingRow"
             x:DataType="models:UpcomingEntry">

    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,6">
        <Label Grid.Column="0"
               Text="{Binding DisplayIcon}"
               FontFamily="MaterialDesignIcons"
               FontSize="22"
               VerticalOptions="Center"
               TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
            <Label Text="{Binding Description}"
                   FontSize="14"
                   FontAttributes="Bold"
                   LineBreakMode="TailTruncation"/>
            <Label FontSize="12"
                   LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding WhenText}" FontAttributes="Bold"/>
                        <Span Text=" · "/>
                        <Span Text="{Binding Date, Converter={StaticResource DateTextConverter}, ConverterParameter=MonthDay}"/>
                        <Span Text=" · "/>
                        <Span Text="{Binding AccountName}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
        <Label Grid.Column="2"
               FontSize="15"
               FontAttributes="Bold"
               VerticalOptions="Center"
               TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}">
            <Label.Text>
                <MultiBinding Converter="{StaticResource CurrencyMoneyConverter}">
                    <Binding Path="SignedAmount"/>
                    <Binding Path="CurrencyCode"/>
                </MultiBinding>
            </Label.Text>
        </Label>
    </Grid>
</ContentView>
