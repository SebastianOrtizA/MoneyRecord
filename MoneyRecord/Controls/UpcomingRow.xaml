<?xml version="1.0" encoding="utf-8" ?>
<!-- One scheduled occurrence (Home's Upcoming card, the Recurring page): icon, description, when, signed amount -->
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             x:Class="MoneyRecord.Controls.UpcomingRow"
             x:DataType="models:UpcomingEntry">

    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,6">
        <Label Grid.Column="0"
               Text="{Binding DisplayIcon}"
               FontFamily="MaterialDesignIcons"
               FontSize="22"
               VerticalOptions="Center"
               TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
            <Label Text="{Binding Description}"
                   FontSize="14"
                   FontAttributes="Bold"
                   LineBreakMode="TailTruncation"/>
            <Label FontSize="12"
                   LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource TextSecondaryDark}}">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="{Binding WhenText}" FontAttributes="Bold"/>
                        <Span Text=" · "/>
                        <Span Text="{Binding Date, Converter={StaticResource DateTextConverter}, ConverterParameter=MonthDay}"/>
                        <Span Text=" · "/>
                        <Span Text="{Binding AccountName}"/>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </VerticalStackLayout>
        <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
            <Label FontSize="15"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="End"
                   IsVisible="{Binding IsFixedAmount}"
                   TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}">
                <Label.Text>
                    <MultiBinding Converter="{StaticResource CurrencyMoneyConverter}">
                        <Binding Path="SignedAmount"/>
                        <Binding Path="CurrencyCode"/>
                    </MultiBinding>
                </Label.Text>
            </Label>
            <!-- A variable amount: the last one as an estimate, or "Amount varies" -->
            <Label Text="{Binding EstimateText}"
                   FontSize="15"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="End"
                   IsVisible="{Binding IsVariable}"
                   TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}"/>
            <!-- Due: tap the row to type the real amount -->
            <Label Text="{ext:Localize EnterOccurrence}"
                   FontSize="12"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="End"
                   IsVisible="{Binding CanEnter}"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#B39DDB}"/>
        </VerticalStackLayout>
    </Grid>
</ContentView>
