<?xml version="1.0" encoding="utf-8" ?>
<!-- A currency selector: shows the chosen currency; a tap opens a searchable list (CurrencyPickerPage) -->
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        x:Class="MoneyRecord.Controls.CurrencyPicker"
        Style="{StaticResource Card}"
        Padding="12,0"
        MinimumHeightRequest="44">
    <Border.GestureRecognizers>
        <TapGestureRecognizer Tapped="OnTapped" />
    </Border.GestureRecognizers>
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MinimumHeightRequest="44">
        <Label x:Name="ValueLabel" FontSize="16" VerticalOptions="Center" LineBreakMode="TailTruncation" />
        <Label Grid.Column="1" Text="&#xF0140;" FontFamily="MaterialDesignIcons" FontSize="24" VerticalOptions="Center" />
    </Grid>
</Border>
