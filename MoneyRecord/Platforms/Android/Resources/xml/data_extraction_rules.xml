<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup (cloud backup and device-to-device transfer). Only what's listed is copied: the database,
     the receipt photos and the preferences (language, theme, base currency, ...). Restore snapshots (Backups/),
     migration copies (moneyrecord.db3.bak-v*), logs and caches stay on the device. So do the encrypted database
     (moneyrecord-encrypted.db3) and SecureStorage with its key: the key is tied to this phone's Keystore, and a
     restored copy could not be read. Keep in sync with backup_rules.xml (AndroidBackupRulesTests checks both). -->
<data-extraction-rules>
	<cloud-backup>
		<include domain="file" path="moneyrecord.db3" />
		<include domain="file" path="receipts/" />
		<include domain="sharedpref" path="." />
		<exclude domain="sharedpref" path="com.sebastianortiz.moneyrecord.microsoft.maui.essentials.preferences.xml" />
	</cloud-backup>
	<device-transfer>
		<include domain="file" path="moneyrecord.db3" />
		<include domain="file" path="receipts/" />
		<include domain="sharedpref" path="." />
		<exclude domain="sharedpref" path="com.sebastianortiz.moneyrecord.microsoft.maui.essentials.preferences.xml" />
	</device-transfer>
</data-extraction-rules>
