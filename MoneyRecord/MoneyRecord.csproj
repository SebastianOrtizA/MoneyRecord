<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>MoneyRecord</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Display name -->
		<ApplicationTitle>MoneyRecord</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.sebastianortiz.moneyrecord</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>0.19.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android' And Exists('$(MSBuildProjectDirectory)\moneyrecord.keystore')">
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>moneyrecord.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>moneyrecord</AndroidSigningKeyAlias>
		<AndroidSigningStorePass>$(KEYSTORE_PASSWORD)</AndroidSigningStorePass>
		<AndroidSigningKeyPass>$(KEY_PASSWORD)</AndroidSigningKeyPass>
	</PropertyGroup>

	<!-- Release code shrinking with R8: renames the Java code (Play's "DEX optimization" check wants obfuscation) and writes
	     mapping.txt, which CI uploads to Play. The SDK's own proguard_xamarin.cfg starts with -dontobfuscate, which would
	     switch renaming off for the whole run, so it is dropped from R8's input and its keep rules live in
	     Platforms/Android/proguard.cfg instead. -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<AndroidLinkTool>r8</AndroidLinkTool>
	</PropertyGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release' And $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
	</ItemGroup>
	<Target Name="DropSdkDontObfuscate" AfterTargets="_CalculateProguardConfigurationFiles" Condition="'$(AndroidLinkTool)' == 'r8'">
		<ItemGroup>
			<_ProguardConfiguration Remove="@(_ProguardConfiguration)" Condition="'%(Filename)%(Extension)' == 'proguard_xamarin.cfg'" />
			<_ProguardConfiguration Include="$(IntermediateOutputPath)proguard_mapping.cfg" />
		</ItemGroup>
		<!-- the SDK file also held -printmapping -->
		<WriteLinesToFile File="$(IntermediateOutputPath)proguard_mapping.cfg" Lines="-printmapping &quot;$([System.IO.Path]::GetFullPath('$(OutputPath)mapping.txt'))&quot;" Overwrite="true" />
	</Target>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\moneyrecord.png" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="512,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

		<!-- The release notes of the "What's new" pop-up: the version history next to the Play store changelogs, one per store locale -->
		<MauiAsset Include="..\fastlane\metadata\android\en-US\changelogs\history.txt" LogicalName="Changelog/en-US.txt" Link="Resources\Changelog\en-US.txt" />
		<MauiAsset Include="..\fastlane\metadata\android\es-ES\changelogs\history.txt" LogicalName="Changelog/es-ES.txt" Link="Resources\Changelog\es-ES.txt" />
		<MauiAsset Include="..\fastlane\metadata\android\es-419\changelogs\history.txt" LogicalName="Changelog/es-419.txt" Link="Resources\Changelog\es-419.txt" />
		<MauiAsset Include="..\fastlane\metadata\android\pt-BR\changelogs\history.txt" LogicalName="Changelog/pt-BR.txt" Link="Resources\Changelog\pt-BR.txt" />
		<MauiAsset Include="..\fastlane\metadata\android\fr-FR\changelogs\history.txt" LogicalName="Changelog/fr-FR.txt" Link="Resources\Changelog\fr-FR.txt" />
		<MauiAsset Include="..\fastlane\metadata\android\it-IT\changelogs\history.txt" LogicalName="Changelog/it-IT.txt" Link="Resources\Changelog\it-IT.txt" />
	</ItemGroup>

	<ItemGroup>
	  <AndroidResource Remove="Platforms\Android\Resources\drawable-night\splash_background.xml" />
	  <AndroidResource Remove="Platforms\Android\Resources\drawable\splash_background.xml" />
	  <AndroidResource Remove="Platforms\Android\Resources\values-night\styles.xml" />
	  <AndroidResource Remove="Platforms\Android\Resources\values\styles.xml" />
	</ItemGroup>

	<!-- Crash reports (opt-in): CI passes the SENTRY_DSN secret as an environment variable, which MSBuild sees as a
	     property. Local and fork builds have none, so they never set up Sentry (MauiProgram.SentryDsn() is null). -->
	<ItemGroup Condition="'$(SENTRY_DSN)' != ''">
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>SentryDsn</_Parameter1>
			<_Parameter2>$(SENTRY_DSN)</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
		<PackageReference Include="LiveChartsCore.SkiaSharpView.Maui" Version="2.0.5" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Sentry.Maui" Version="6.11.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
	</ItemGroup>

	<!-- Android only: the daily background job (WorkManager), the app lock (Biometric) and receipt reading (ML Kit) -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Xamarin.AndroidX.Work.Runtime" Version="2.10.3" />
		<!-- App lock: the phone's fingerprint / face / screen lock (BiometricPrompt) -->
		<PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.30" />
		<!-- Receipt OCR: ML Kit text recognition with the model bundled in the APK (on the phone, no Play Services needed) -->
		<PackageReference Include="Xamarin.Google.MLKit.TextRecognition" Version="116.0.1.4" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MoneyRecord.Core\MoneyRecord.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Controls\FloatingActionMenu.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\AddTransferPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\BudgetPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ExpenseReportPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\IncomeReportPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\MainPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ManageAccountsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ManageCategoriesPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\TransfersPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>
