<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:helpers="clr-namespace:MoneyRecord.Helpers;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:behaviors="clr-namespace:MoneyRecord.Behaviors"
             x:Class="MoneyRecord.Views.BudgetPage"
             x:DataType="viewmodels:BudgetViewModel"
             Title="{ext:Localize Budgets}">

    <ContentPage.Resources>
        <Style x:Key="BudgetTotalLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
        </Style>
        <Style x:Key="BudgetTotalAmount" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <RefreshView IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadBudgetsCommand}">
            <!-- Header = period and totals, items = one card per budget (a tap opens the edit sheet), footer = empty state -->
            <!-- The 16px gutter is inside the header, rows and footer, so the scrollbar sits at the screen edge -->
            <CollectionView ItemsSource="{Binding Budgets}">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="12" Padding="16,12,16,4">
                        <controls:PeriodPicker BindingContext="{Binding Period}" />

                        <!-- Totals -->
                        <Border IsVisible="{Binding HasBudgets}"
                                Padding="16,12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                            <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="4">
                                <Label Text="{ext:Localize TotalBudgeted}" Style="{StaticResource BudgetTotalLabel}" />
                                <Label Grid.Row="1"
                                       Text="{Binding TotalBudgeted, Converter={StaticResource MoneyConverter}}"
                                       Style="{StaticResource BudgetTotalAmount}" />

                                <Label Grid.Column="1" Text="{ext:Localize TotalSpent}" Style="{StaticResource BudgetTotalLabel}" />
                                <Label Grid.Row="1" Grid.Column="1"
                                       Text="{Binding TotalSpent, Converter={StaticResource MoneyConverter}}"
                                       Style="{StaticResource BudgetTotalAmount}" />

                                <Label Grid.Column="2" Text="{ext:Localize TotalRemaining}" Style="{StaticResource BudgetTotalLabel}" />
                                <Label Grid.Row="1" Grid.Column="2"
                                       Text="{Binding TotalRemaining, Converter={StaticResource MoneyConverter}}"
                                       Style="{StaticResource BudgetTotalAmount}" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:BudgetProgress">
                        <Border Style="{StaticResource Card}" Margin="16,6" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:BudgetViewModel}}, Path=EditBudgetCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="Ellipse"
                                            VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                        <Label Text="{Binding DisplayIcon}"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="20"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    </Border>

                                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding CategoryName}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <!-- "Per Month · $500.00": the limit as set -->
                                        <Label FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding Period, Converter={StaticResource BudgetPeriodToDisplayConverter}}" />
                                                    <Span Text=" · " />
                                                    <Span Text="{Binding OriginalLimitAmount, Converter={StaticResource MoneyConverter}}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </VerticalStackLayout>

                                    <!-- Status: icon + words + colour, so colour isn't the only signal -->
                                    <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                        <Label Text="{Binding StatusIcon}"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="16"
                                               VerticalOptions="Center"
                                               TextColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}" />
                                        <Label Text="{Binding StatusText}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               VerticalOptions="Center"
                                               TextColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}" />
                                    </HorizontalStackLayout>
                                </Grid>

                                <ProgressBar Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                             ProgressColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}"
                                             BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                             HeightRequest="10" />

                                <!-- Spent of the limit for the shown period; what is left or how much over -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding SpentOfLimitText}" FontSize="14" />
                                    <Label Grid.Column="1"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           TextColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding IsOverBudget, Converter={StaticResource BoolToOverBudgetLabelConverter}}" />
                                                <Span Text=" " />
                                                <Span>
                                                    <Span.Text>
                                                        <MultiBinding Converter="{StaticResource OverBudgetAmountConverter}">
                                                            <Binding Path="IsOverBudget" />
                                                            <Binding Path="ExceededAmount" />
                                                            <Binding Path="RemainingAmount" />
                                                        </MultiBinding>
                                                    </Span.Text>
                                                </Span>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                </Grid>

                                <!-- Expenses in other currencies: listed, not counted against the limit (base currency) -->
                                <Label Text="{Binding UncountedText}"
                                       IsVisible="{Binding HasUncounted}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout>
                        <!-- Empty state -->
                        <VerticalStackLayout Spacing="12"
                                             Padding="32,48"
                                             IsVisible="{Binding HasBudgets, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="&#xF08C9;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="64"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{ext:Localize NoBudgetsYet}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{ext:Localize AddBudgetToStart}"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        </VerticalStackLayout>
                        <!-- Room so the last card scrolls above the add button -->
                        <ContentView HeightRequest="88" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <Button Text="&#xF0415;"
                FontFamily="MaterialDesignIcons"
                FontSize="28"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                Padding="0"
                Margin="0,0,16,16"
                HorizontalOptions="End"
                VerticalOptions="End"
                SemanticProperties.Description="{ext:Localize AddCategoryToBudget}"
                IsVisible="{Binding IsFormOpen, Converter={StaticResource InvertedBoolConverter}}"
                Command="{Binding AddBudgetCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.35}" />

        <!-- Add / edit sheet: category (when adding), period and limit -->
        <controls:BottomSheet IsOpen="{Binding IsFormOpen}" CloseCommand="{Binding CloseFormCommand}">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding FormTitle}" FontSize="18" FontAttributes="Bold" Margin="0,0,0,4" />

                <Label Text="{ext:Localize Category}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                <Picker ItemsSource="{Binding AvailableCategories}"
                        SelectedItem="{Binding SelectedCategory}"
                        ItemDisplayBinding="{Binding Name, x:DataType=models:Category}"
                        Title="{ext:Localize SelectCategory}"
                        IsVisible="{Binding IsEditMode, Converter={StaticResource InvertedBoolConverter}}"
                        FontSize="16"
                        MinimumHeightRequest="44" />
                <Label Text="{Binding EditingBudget.CategoryName}"
                       IsVisible="{Binding IsEditMode}"
                       FontSize="16"
                       Margin="0,4,0,8" />

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                    <Label Text="{ext:Localize BudgetLimit}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <Label Grid.Column="1"
                           Text="{ext:Localize BudgetPeriod}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <controls:DecimalEntry Grid.Row="1"
                                           Text="{Binding BudgetAmount}"
                                           Placeholder="0.00"
                                           FontSize="16">
                        <controls:DecimalEntry.Behaviors>
                            <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" />
                        </controls:DecimalEntry.Behaviors>
                    </controls:DecimalEntry>
                    <Picker Grid.Row="1" Grid.Column="1"
                            ItemsSource="{Binding BudgetPeriods}"
                            SelectedItem="{Binding SelectedBudgetPeriod}"
                            Title="{ext:Localize BudgetPeriod}"
                            FontSize="16"
                            MinimumHeightRequest="44" />
                </Grid>

                <!-- Delete only when editing -->
                <Grid ColumnDefinitions="Auto,*" Margin="0,12,0,0">
                    <Button Text="{ext:Localize DeleteButton}"
                            IsVisible="{Binding IsEditMode}"
                            Command="{Binding DeleteBudgetCommand}"
                            Margin="0,0,12,0"
                            MinimumHeightRequest="44"
                            Padding="20,0"
                            CornerRadius="22"
                            BorderWidth="1"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                    <Button Grid.Column="1"
                            Text="{Binding SaveText}"
                            Command="{Binding SaveBudgetCommand}"
                            MinimumHeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                </Grid>
            </VerticalStackLayout>
        </controls:BottomSheet>
    </Grid>

</ContentPage>
