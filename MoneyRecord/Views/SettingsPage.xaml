<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{ext:Localize Settings}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Language and theme -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF03D8;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize LanguageAndAppearance}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize LanguageAndAppearanceDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{ext:Localize Language}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Picker ItemsSource="{Binding Languages}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:LanguageOption}"
                                SelectedItem="{Binding SelectedLanguage}"
                                Title="{ext:Localize Language}"
                                FontSize="16"
                                MinimumHeightRequest="44"/>
                        <Label Text="{ext:Localize Theme}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Picker ItemsSource="{Binding Themes}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:ThemeOption}"
                                SelectedItem="{Binding SelectedTheme}"
                                Title="{ext:Localize Theme}"
                                FontSize="16"
                                MinimumHeightRequest="44"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Base Currency Section -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF0116;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize BaseCurrency}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize BaseCurrencyDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Picker ItemsSource="{Binding AvailableCurrencies}"
                                SelectedItem="{Binding BaseCurrency}"
                                Title="{ext:Localize SelectCurrency}"
                                FontSize="16"
                                MinimumHeightRequest="44"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Setup assistant (the first-run setup, again) -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSetupCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF0068;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize SetupAssistant}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize SetupAssistantDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xF0142;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                    </Grid>
                </Frame>

                <!-- Backup Section -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF0613;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize BackupRestore}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize BackupRestoreDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{ext:Localize ExportFullBackup}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                               Margin="0,4,0,0"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="{ext:Localize SaveBackupLocal}"
                                    Command="{Binding SaveBackupLocalCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"
                                    TextColor="White"
                                    FontSize="14"
                                    HeightRequest="48"
                                    CornerRadius="10"/>
                            <Button Grid.Column="1"
                                    Text="{ext:Localize ShareBackupExternal}"
                                    Command="{Binding ShareBackupCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{AppThemeBinding Light=#7B1FA2, Dark=#CE93D8}"
                                    TextColor="White"
                                    FontSize="14"
                                    HeightRequest="48"
                                    CornerRadius="10"/>
                        </Grid>

                        <Button Text="{ext:Localize ExportTransactionsCsv}"
                                Command="{Binding ExportCsvCommand}"
                                IsEnabled="{Binding IsExporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}"
                                TextColor="White"
                                FontSize="15"
                                HeightRequest="48"
                                CornerRadius="10"/>

                        <Button Text="{ext:Localize RestoreFromBackup}"
                                Command="{Binding RestoreCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}"
                                TextColor="White"
                                FontSize="15"
                                HeightRequest="48"
                                CornerRadius="10"/>

                        <!-- Restore Warning -->
                        <Label Text="{ext:Localize RestoreNote}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                               FontAttributes="Italic"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Share logs: the error log as a zip, to report a problem -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShareLogsCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF0219;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize ShareLogs}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize ShareLogsDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xF0497;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                    </Grid>
                </Frame>

                <!-- Reminders (opt-in), where notifications are supported (Android). A Border styled like the Frames
                     around it (Frame is obsolete; 11.5 converts the rest) -->
                <Border IsVisible="{Binding RemindersSupported}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF009A;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize Reminders}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize RemindersDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding RemindersEnabled}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding RemindersEnabled}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize BillReminders}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Picker Grid.Column="1"
                                        WidthRequest="170"
                                        ItemsSource="{Binding BillReminderOptions}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=models:BillReminderOption}"
                                        SelectedItem="{Binding SelectedBillReminder}"
                                        Title="{ext:Localize BillReminders}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize BudgetAlerts}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding BudgetAlertsEnabled}"
                                        VerticalOptions="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize RecurringAddedAlerts}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding RecurringAddedEnabled}"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- App lock (the phone's own lock), where supported (Android) -->
                <Border IsVisible="{Binding AppLockSupported}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                        StrokeShape="RoundRectangle 12"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF033E;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize AppLock}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize AppLockDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding AppLockEnabled}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding AppLockEnabled}">
                            <Label Text="{ext:Localize LockAfter}"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Picker Grid.Column="1"
                                    WidthRequest="170"
                                    ItemsSource="{Binding LockDelayOptions}"
                                    ItemDisplayBinding="{Binding Name, x:DataType=models:LockDelayOption}"
                                    SelectedItem="{Binding SelectedLockDelay}"
                                    Title="{ext:Localize LockAfter}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Crash reports (opt-in), only in builds that can send them -->
                <Frame IsVisible="{Binding CrashReportsAvailable}"
                       BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF00E4;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize CrashReports}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize CrashReportsDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                IsToggled="{Binding CrashReportsEnabled}"
                                VerticalOptions="Center"/>
                    </Grid>
                </Frame>

                <!-- About: version, licence, open-source components -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF02FC;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize About}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize AboutDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xF0142;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
