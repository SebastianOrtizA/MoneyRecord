<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:corevm="clr-namespace:MoneyRecord.ViewModels;assembly=MoneyRecord.Core"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.SettingsPage"
             x:DataType="viewmodels:SettingsViewModel"
             Title="{ext:Localize Settings}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Language and theme -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF03D8;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize LanguageAndAppearance}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize LanguageAndAppearanceDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{ext:Localize Language}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Picker ItemsSource="{Binding Languages}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:LanguageOption}"
                                SelectedIndex="{Binding SelectedLanguageIndex}"
                                Title="{ext:Localize Language}"
                                FontSize="16"
                                MinimumHeightRequest="44"/>
                        <Label Text="{ext:Localize Theme}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Picker ItemsSource="{Binding Themes}"
                                ItemDisplayBinding="{Binding Name, x:DataType=models:ThemeOption}"
                                SelectedItem="{Binding SelectedTheme}"
                                Title="{ext:Localize Theme}"
                                FontSize="16"
                                MinimumHeightRequest="44"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Base Currency Section -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF0116;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize BaseCurrency}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize BaseCurrencyDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </Grid>
                        <Picker ItemsSource="{Binding AvailableCurrencies}"
                                SelectedItem="{Binding BaseCurrency}"
                                Title="{ext:Localize SelectCurrency}"
                                FontSize="16"
                                MinimumHeightRequest="44"/>

                        <!-- Show cents: one switch per currency in use that has cents -->
                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding Cents.CurrencyOptions.Count, Converter={StaticResource IntToBoolConverter}}">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{ext:Localize ShowCents}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize ShowCentsDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Cents.CurrencyOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="corevm:CurrencyCentsOption">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MinimumHeightRequest="48">
                                            <VerticalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                                <Label FontSize="15"
                                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}">
                                                    <Label.FormattedText>
                                                        <FormattedString>
                                                            <Span Text="{Binding Code}" FontAttributes="Bold"/>
                                                            <Span Text="{Binding Name, StringFormat=' · {0}'}"/>
                                                        </FormattedString>
                                                    </Label.FormattedText>
                                                </Label>
                                                <Label Text="{Binding Sample}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                            </VerticalStackLayout>
                                            <Switch Grid.Column="1"
                                                    IsToggled="{Binding ShowsCents}"
                                                    VerticalOptions="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Exchange rates (opt-in download: it needs the internet) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF01E7;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize ExchangeRates}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize ExchangeRatesDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding ExchangeRatesEnabled}"
                                    VerticalOptions="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding ExchangeRatesEnabled}">
                            <Label Text="{Binding ExchangeRatesStatus}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <Button Grid.Column="1"
                                    Text="{ext:Localize UpdateNow}"
                                    Command="{Binding UpdateExchangeRatesCommand}"
                                    FontSize="14"
                                    HeightRequest="40"
                                    Padding="16,0"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Setup assistant (the first-run setup, again) -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSetupCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF0068;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize SetupAssistant}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize SetupAssistantDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xF0142;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                    </Grid>
                </Border>

                <!-- Home screen (card order and visibility) -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenHomeLayoutCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF02DC;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize HomeLayoutTitle}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize HomeLayoutDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xF0142;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                    </Grid>
                </Border>

                <!-- Backup Section -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="16">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF0613;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize BackupRestore}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize BackupRestoreDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="{ext:Localize ExportFullBackup}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                               Margin="0,4,0,0"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="{ext:Localize SaveBackupLocal}"
                                    Command="{Binding SaveBackupLocalCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"
                                    TextColor="White"
                                    FontSize="14"
                                    HeightRequest="48"
                                    CornerRadius="10"/>
                            <Button Grid.Column="1"
                                    Text="{ext:Localize ShareBackupExternal}"
                                    Command="{Binding ShareBackupCommand}"
                                    IsEnabled="{Binding IsExporting, Converter={StaticResource InvertedBoolConverter}}"
                                    BackgroundColor="{AppThemeBinding Light=#7B1FA2, Dark=#CE93D8}"
                                    TextColor="White"
                                    FontSize="14"
                                    HeightRequest="48"
                                    CornerRadius="10"/>
                        </Grid>

                        <!-- The backup password: manual and automatic backups are encrypted with it -->
                        <VerticalStackLayout BindingContext="{Binding BackupPassword}"
                                             x:DataType="corevm:BackupPasswordViewModel"
                                             IsVisible="{Binding IsSupported}"
                                             Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize BackupPassword}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding IsProtected}"
                                        VerticalOptions="Center"/>
                            </Grid>
                            <Label Text="{ext:Localize BackupPasswordDescription}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <Button Text="{ext:Localize ChangePassword}"
                                    Command="{Binding SetPasswordCommand}"
                                    IsVisible="{Binding IsProtected}"
                                    HorizontalOptions="Start"
                                    FontSize="14"
                                    HeightRequest="40"
                                    Padding="16,0"/>
                        </VerticalStackLayout>

                        <Button Text="{ext:Localize ExportTransactionsCsv}"
                                Command="{Binding ExportCsvCommand}"
                                IsEnabled="{Binding IsExporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}"
                                TextColor="White"
                                FontSize="15"
                                HeightRequest="48"
                                CornerRadius="10"/>

                        <!-- Bank statement (CSV) into one account; not a restore, nothing is replaced -->
                        <Button Text="{ext:Localize ImportStatement}"
                                Command="{Binding OpenImportCommand}"
                                BackgroundColor="{AppThemeBinding Light=#00796B, Dark=#4DB6AC}"
                                TextColor="White"
                                FontSize="15"
                                HeightRequest="48"
                                CornerRadius="10"/>
                        <Label Text="{ext:Localize ImportStatementDescription}"
                               FontSize="12"
                               Margin="0,-4,0,4"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                        <Button Text="{ext:Localize RestoreFromBackup}"
                                Command="{Binding RestoreCommand}"
                                IsEnabled="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}"
                                TextColor="White"
                                FontSize="15"
                                HeightRequest="48"
                                CornerRadius="10"/>

                        <!-- Restore Warning -->
                        <Label Text="{ext:Localize RestoreNote}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                               FontAttributes="Italic"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Automatic backups into a folder the user picks, where supported (Android) -->
                <Border Style="{StaticResource Card}" BindingContext="{Binding AutoBackup}"
                        x:DataType="corevm:AutoBackupViewModel"
                        IsVisible="{Binding IsSupported}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF0167;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#00897B, Dark=#4DB6AC}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize AutoBackups}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize AutoBackupsDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding Enabled}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding Enabled}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize BackupFolder}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Grid.Column="1"
                                       Text="{Binding FolderText}"
                                       FontSize="15"
                                       LineBreakMode="MiddleTruncation"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                <Button Grid.Column="2"
                                        Text="{ext:Localize ChooseFolder}"
                                        Command="{Binding ChooseFolderCommand}"
                                        IsEnabled="{Binding IsIdle}"
                                        FontSize="14"
                                        HeightRequest="40"
                                        Padding="16,0"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize BackupFrequency}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Picker Grid.Column="1"
                                        WidthRequest="170"
                                        ItemsSource="{Binding FrequencyOptions}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=models:BackupFrequencyOption}"
                                        SelectedItem="{Binding SelectedFrequency}"
                                        Title="{ext:Localize BackupFrequency}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize BackupsToKeep}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Picker Grid.Column="1"
                                        WidthRequest="170"
                                        ItemsSource="{Binding KeepOptions}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=models:BackupKeepOption}"
                                        SelectedItem="{Binding SelectedKeep}"
                                        Title="{ext:Localize BackupsToKeep}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{Binding Status}"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                <Button Grid.Column="1"
                                        Text="{ext:Localize BackUpNow}"
                                        Command="{Binding BackUpNowCommand}"
                                        IsEnabled="{Binding CanBackUpNow}"
                                        FontSize="14"
                                        HeightRequest="40"
                                        Padding="16,0"/>
                            </Grid>
                            <Label Text="{ext:Localize AutoBackupNote}"
                                   FontSize="12"
                                   FontAttributes="Italic"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Share logs: the error log as a zip, to report a problem -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShareLogsCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF0219;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize ShareLogs}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize ShareLogsDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xF0497;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                    </Grid>
                </Border>

                <!-- Reminders (opt-in), where notifications are supported (Android) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding RemindersSupported}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF009A;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#F57C00, Dark=#FFB74D}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize Reminders}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize RemindersDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding RemindersEnabled}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding RemindersEnabled}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize BillReminders}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Picker Grid.Column="1"
                                        WidthRequest="170"
                                        ItemsSource="{Binding BillReminderOptions}"
                                        ItemDisplayBinding="{Binding Name, x:DataType=models:BillReminderOption}"
                                        SelectedItem="{Binding SelectedBillReminder}"
                                        Title="{ext:Localize BillReminders}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize BudgetAlerts}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding BudgetAlertsEnabled}"
                                        VerticalOptions="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Label Text="{ext:Localize RecurringAddedAlerts}"
                                       FontSize="15"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding RecurringAddedEnabled}"
                                        VerticalOptions="Center"/>
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- App lock (the phone's own lock), where supported (Android) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding AppLockSupported}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Label Grid.Column="0"
                                   Text="&#xF033E;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="28"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="{ext:Localize AppLock}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                                <Label Text="{ext:Localize AppLockDescription}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            </VerticalStackLayout>
                            <Switch Grid.Column="2"
                                    IsToggled="{Binding AppLockEnabled}"
                                    VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding AppLockEnabled}">
                            <Label Text="{ext:Localize LockAfter}"
                                   FontSize="15"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Picker Grid.Column="1"
                                    WidthRequest="170"
                                    ItemsSource="{Binding LockDelayOptions}"
                                    ItemDisplayBinding="{Binding Name, x:DataType=models:LockDelayOption}"
                                    SelectedItem="{Binding SelectedLockDelay}"
                                    Title="{ext:Localize LockAfter}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Database encryption (opt-in), where the key can be kept (Android) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding EncryptionSupported}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF0AAA;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize EncryptDatabase}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize EncryptDatabaseDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                IsToggled="{Binding DatabaseEncrypted}"
                                IsEnabled="{Binding IsChangingEncryption, Converter={StaticResource InvertedBoolConverter}}"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- Crash reports (opt-in), only in builds that can send them -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding CrashReportsAvailable}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF00E4;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize CrashReports}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize CrashReportsDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="2"
                                IsToggled="{Binding CrashReportsEnabled}"
                                VerticalOptions="Center"/>
                    </Grid>
                </Border>

                <!-- About: version, licence, open-source components -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAboutCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Grid.Column="0"
                               Text="&#xF02FC;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="28"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize About}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <Label Text="{ext:Localize AboutDescription}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xF0142;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"/>
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
