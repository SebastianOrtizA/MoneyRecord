<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.AboutPage"
             x:DataType="viewmodels:AboutViewModel"
             Title="{ext:Localize About}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <!-- The app: version, AGPL licence, source -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="MoneyRecord" FontSize="22" FontAttributes="Bold" />
                    <Label Text="{Binding VersionText}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <Label Text="{ext:Localize AppLicenseNotice}" FontSize="14" Margin="0,4,0,0" />
                    <Button Text="{ext:Localize SourceCode}"
                            Command="{Binding OpenSourceCodeCommand}"
                            HorizontalOptions="Start"
                            Margin="0,4,0,0"
                            HeightRequest="44"
                            Padding="20,0"
                            CornerRadius="22"
                            BorderWidth="1"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </VerticalStackLayout>
            </Border>

            <!-- Third-party components; a tap shows the licence text -->
            <VerticalStackLayout Spacing="4">
                <Label Text="{ext:Localize OpenSourceComponents}" FontSize="18" FontAttributes="Bold" />
                <Label Text="{ext:Localize OpenSourceComponentsDescription}" FontSize="13" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}" Padding="0">
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Components}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:ThirdPartyComponent">
                            <Grid ColumnDefinitions="*,Auto" Padding="16,12" ColumnSpacing="8">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AboutViewModel}}, Path=OpenComponentCommand, x:DataType=viewmodels:AboutViewModel}"
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" />
                                    <Label Text="{Binding License}" FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    <Label Text="{Binding Copyright, StringFormat='© {0}'}" FontSize="12"
                                           IsVisible="{Binding Copyright, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="&#xF0142;"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="22"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
