<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:behaviors="clr-namespace:MoneyRecord.Behaviors"
             x:Class="MoneyRecord.Views.TripsPage"
             x:DataType="viewmodels:TripsViewModel"
             Title="{ext:Localize TripsTitle}">

    <ContentPage.Resources>
        <Style x:Key="FormCaption" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding LoadTripsCommand}">
            <!-- One card per trip (a tap opens it); the 16px gutter is inside the rows so the scrollbar sits at the edge -->
            <CollectionView ItemsSource="{Binding Cards}">
                <CollectionView.Header>
                    <Button Text="{ext:Localize TripCategoriesTitle}"
                            Command="{Binding OpenCategoriesCommand}"
                            Margin="16,8,16,2"
                            HeightRequest="40"
                            CornerRadius="20"
                            BorderWidth="1"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TripCard">
                        <Border Style="{StaticResource Card}" Margin="16,6" Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TripsViewModel}}, Path=OpenTripCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Name}" FontSize="16" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                    <Label Grid.Column="1" Text="{Binding StateText}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Grid>
                                <Label Text="{Binding DatesText}" FontSize="13" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                <ProgressBar IsVisible="{Binding HasBudget}"
                                             Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                             ProgressColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}"
                                             BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                             HeightRequest="10" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding SpentText}" FontSize="14" />
                                    <Label Grid.Column="1" Text="{Binding StatusText}" IsVisible="{Binding HasBudget}" FontSize="13" FontAttributes="Bold"
                                           TextColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}" />
                                </Grid>
                                <Label Text="{Binding NotConvertedText}" IsVisible="{Binding HasNotConverted}" FontSize="13"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout>
                        <VerticalStackLayout Spacing="12" Padding="32,48"
                                             IsVisible="{Binding HasTrips, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Text="&#xF001D;" FontFamily="MaterialDesignIcons" FontSize="64" HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{ext:Localize NoTripsYet}" FontSize="18" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                            <Label Text="{ext:Localize AddTripToStart}" FontSize="14" HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        </VerticalStackLayout>
                        <!-- Room so the last card scrolls above the add button -->
                        <ContentView HeightRequest="88" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <Button Text="&#xF0415;"
                FontFamily="MaterialDesignIcons"
                FontSize="28"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                Padding="0"
                Margin="0,0,16,16"
                HorizontalOptions="End"
                VerticalOptions="End"
                SemanticProperties.Description="{ext:Localize StartTrip}"
                IsVisible="{Binding IsFormOpen, Converter={StaticResource InvertedBoolConverter}}"
                Command="{Binding AddTripCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.35}" />

        <!-- Start / edit sheet: name, dates, currency, budget, default account, limits per trip category -->
        <controls:BottomSheet Scroll="{x:Reference FormScroll}" IsOpen="{Binding IsFormOpen}" CloseCommand="{Binding CloseFormCommand}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Label Text="{Binding FormTitle}" FontSize="18" FontAttributes="Bold" />

                <ScrollView Grid.Row="1" x:Name="FormScroll">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{ext:Localize TripName}" Style="{StaticResource FormCaption}" />
                        <Entry Text="{Binding FormName}" Placeholder="{ext:Localize TripNamePlaceholder}" MaxLength="60" FontSize="16" />

                        <Label Text="{ext:Localize TripStartDate}" Style="{StaticResource FormCaption}" />
                        <DatePicker Date="{Binding FormStartDate}" Format="D" FontSize="16" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <Label Text="{ext:Localize EndDateOptional}" FontSize="16" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding HasEndDate}"
                                    OnColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        </Grid>
                        <DatePicker Date="{Binding FormEndDate}" Format="D" FontSize="16" IsVisible="{Binding HasEndDate}" />

                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <Label Text="{ext:Localize TripBudgetOptional}" Style="{StaticResource FormCaption}" />
                            <Label Grid.Column="1" Text="{ext:Localize Currency}" Style="{StaticResource FormCaption}" />
                            <controls:DecimalEntry Grid.Row="1" Text="{Binding FormBudget}" Placeholder="0.00" FontSize="16">
                                <controls:DecimalEntry.Behaviors>
                                    <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding FormCurrency}" />
                                </controls:DecimalEntry.Behaviors>
                            </controls:DecimalEntry>
                            <Picker Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Currencies}" SelectedItem="{Binding FormCurrency}"
                                    Title="{ext:Localize SelectCurrency}" WidthRequest="96" FontSize="16" MinimumHeightRequest="44" />
                        </Grid>

                        <Label Text="{ext:Localize TripDefaultAccount}" Style="{StaticResource FormCaption}" />
                        <Picker ItemsSource="{Binding AccountChoices}" ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding SelectedAccount}" FontSize="16" MinimumHeightRequest="44" />

                        <Label Text="{ext:Localize TripLimits}" Style="{StaticResource FormCaption}" Margin="0,8,0,0" />
                        <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding LimitRows}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:TripLimitRow">
                                    <Grid ColumnDefinitions="Auto,*,130" ColumnSpacing="8" MinimumHeightRequest="44">
                                        <Label Text="{Binding Category.DisplayIcon}" FontFamily="MaterialDesignIcons" FontSize="20" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Label Grid.Column="1" Text="{Binding Category.Name}" FontSize="16" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                        <controls:DecimalEntry Grid.Column="2" Text="{Binding Limit}" Placeholder="0.00" FontSize="16" HorizontalTextAlignment="End" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                        <Label Text="{ext:Localize TripLimitsHint}" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="2"
                        Text="{Binding SaveText}"
                        Command="{Binding SaveTripCommand}"
                        HeightRequest="44"
                        CornerRadius="22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
            </Grid>
        </controls:BottomSheet>
    </Grid>

</ContentPage>
