<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             x:Class="MoneyRecord.Views.ChallengePage"
             x:DataType="viewmodels:ChallengeViewModel"
             Title="{Binding Title}">

    <RefreshView IsRefreshing="{Binding IsLoading}"
                 Command="{Binding LoadCommand}">
        <!-- A cell per day, seven to a row; the summary and the filter chip are the header -->
        <CollectionView ItemsSource="{Binding Cells}" SelectionMode="None">
            <CollectionView.ItemsLayout>
                <GridItemsLayout Orientation="Vertical" Span="7" HorizontalItemSpacing="4" VerticalItemSpacing="4" />
            </CollectionView.ItemsLayout>

            <CollectionView.Header>
                <VerticalStackLayout Spacing="12" Padding="16,6,16,12" IsVisible="{Binding HasChallenge}">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="10" BindingContext="{Binding Summary}" x:DataType="models:ChallengeSummary">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding SavedOfText}" FontSize="16" FontAttributes="Bold" />
                                <Label Grid.Column="1"
                                       Text="{Binding DaysLeftText}"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Grid>
                            <ProgressBar Progress="{Binding Fraction}"
                                         ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                         BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                         HeightRequest="10" />
                            <Label Text="{Binding Fraction, StringFormat='{0:P0}'}" FontSize="14" />
                        </VerticalStackLayout>
                    </Border>
                    <!-- Wraps, so every view is in sight (a scrolling row hid Date range off screen) -->
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding ViewChips}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ChallengeViewChip">
                                <controls:FilterChip Text="{Binding Label}"
                                                     IsActive="{Binding IsActive}"
                                                     IsVisible="{Binding IsAvailable}"
                                                     Margin="0,0,6,6"
                                                     Command="{Binding SelectCommand}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" IsVisible="{Binding IsRangeView}">
                        <Label Text="{ext:Localize ChallengeRangeFrom}" Style="{StaticResource MutedLabel}" />
                        <Label Grid.Column="1" Text="{ext:Localize ChallengeRangeTo}" Style="{StaticResource MutedLabel}" />
                        <DatePicker Grid.Row="1" Date="{Binding RangeFrom}" Format="d" FontSize="16" />
                        <DatePicker Grid.Row="1" Grid.Column="1" Date="{Binding RangeTo}" Format="d" FontSize="16" />
                    </Grid>
                    <controls:FilterChip Text="{ext:Localize ChallengeRemainingOnly}"
                                         IsActive="{Binding ShowRemainingOnly}"
                                         Command="{Binding ToggleRemainingOnlyCommand}"
                                         HorizontalOptions="Start" />
                    <Label Text="{Binding ShowingText}" IsVisible="{Binding HasShowing}"
                           Style="{StaticResource MutedLabel}" FontSize="13" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ChallengeCell">
                    <Border HeightRequest="62" Padding="2" Margin="0"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#D0D0D0, Dark=#4A4A4A}"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"
                            SemanticProperties.Description="{Binding Description}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ChallengeViewModel}}, Path=ToggleDayCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <!-- Today: outlined -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsToday}" Value="True">
                                <Setter Property="StrokeThickness" Value="3" />
                                <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                            <!-- Done: filled -->
                            <DataTrigger TargetType="Border" Binding="{Binding IsDone}" Value="True">
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding DateText}" FontSize="10" HorizontalTextAlignment="Center" LineBreakMode="NoWrap">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <controls:AutoFitLabel Text="{Binding AmountText}" MaxFontSize="13" MinFontSize="7"
                                                   FontAttributes="Bold"
                                                   HorizontalOptions="Fill" HorizontalTextAlignment="Center">
                                <controls:AutoFitLabel.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsDone}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsMissed}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                                    </DataTrigger>
                                </controls:AutoFitLabel.Triggers>
                            </controls:AutoFitLabel>
                            <!-- Done: a check, so colour is not the only signal -->
                            <Label Text="&#xF012C;" FontFamily="MaterialDesignIcons" FontSize="12" HorizontalTextAlignment="Center"
                                   IsVisible="{Binding IsDone}"
                                   TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <Label Text="{ext:Localize ChallengeNoDaysInView}" HorizontalTextAlignment="Center" Margin="16,24" IsVisible="{Binding HasNoCells}" />
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <ContentView HeightRequest="24" />
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>

</ContentPage>
