<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.ImportStatementPage"
             Shell.TabBarIsVisible="False"
             x:DataType="viewmodels:ImportStatementViewModel"
             Title="{ext:Localize ImportStatement}">

    <!-- Choose a file → check the columns → preview the rows → Import stays at the bottom -->
    <Grid RowDefinitions="*,Auto">
        <CollectionView ItemsSource="{Binding Rows}" SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Padding="16,16,16,8" Spacing="12">

                    <!-- Before a file: what to export from the bank -->
                    <VerticalStackLayout Spacing="16" IsVisible="{Binding HasFile, Converter={StaticResource InvertedBoolConverter}}"
                                         Padding="0,24,0,0">
                        <Label Text="&#xF0220;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="56"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <Label Text="{ext:Localize ImportIntro}"
                               FontSize="15"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Button Text="{ext:Localize ImportChooseFile}"
                                Command="{Binding ChooseFileCommand}"
                                HeightRequest="48"
                                CornerRadius="24"
                                FontAttributes="Bold"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                    </VerticalStackLayout>

                    <!-- The file and its columns -->
                    <VerticalStackLayout Spacing="12" IsVisible="{Binding HasFile}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{Binding FileSummary}"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   LineBreakMode="MiddleTruncation"/>
                            <Button Grid.Column="1"
                                    Text="{ext:Localize ImportChooseAnotherFile}"
                                    Command="{Binding ChooseFileCommand}"
                                    FontSize="13"
                                    Padding="12,0"
                                    HeightRequest="36"
                                    CornerRadius="18"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}"
                                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        </Grid>

                        <!-- A bank's file seen before: its last import's columns and account -->
                        <Border Padding="10,8"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                IsVisible="{Binding UsesSavedMapping}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="&#xF02DA;"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                <Label Grid.Column="1"
                                       Text="{ext:Localize ImportSavedMapping}"
                                       FontSize="13"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                            </Grid>
                        </Border>

                        <Label Text="{ext:Localize Account}" FontSize="14" FontAttributes="Bold"/>
                        <Picker ItemsSource="{Binding Accounts}"
                                SelectedItem="{Binding SelectedAccount}"
                                ItemDisplayBinding="{Binding Name}"
                                Title="{ext:Localize SelectAccount}"/>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                            <Label Text="{ext:Localize ImportDateColumn}" FontSize="14" FontAttributes="Bold"/>
                            <Picker Grid.Row="1"
                                    ItemsSource="{Binding DateColumns}"
                                    SelectedItem="{Binding SelectedDateColumn}"
                                    ItemDisplayBinding="{Binding Name}"
                                    Title="{ext:Localize ImportDateColumn}"/>
                            <Label Grid.Column="1" Text="{ext:Localize ImportAmountColumn}" FontSize="14" FontAttributes="Bold"/>
                            <Picker Grid.Row="1" Grid.Column="1"
                                    ItemsSource="{Binding AmountColumns}"
                                    SelectedItem="{Binding SelectedAmountColumn}"
                                    ItemDisplayBinding="{Binding Name}"
                                    Title="{ext:Localize ImportAmountColumn}"/>
                            <Label Grid.Row="2" Text="{ext:Localize ImportDescriptionColumn}" FontSize="14" FontAttributes="Bold"
                                   Margin="0,8,0,0"/>
                            <Picker Grid.Row="3"
                                    ItemsSource="{Binding DescriptionColumns}"
                                    SelectedItem="{Binding SelectedDescriptionColumn}"
                                    ItemDisplayBinding="{Binding Name}"
                                    Title="{ext:Localize ImportDescriptionColumn}"/>
                            <Label Grid.Row="2" Grid.Column="1" Text="{ext:Localize ImportDateFormat}" FontSize="14"
                                   FontAttributes="Bold" Margin="0,8,0,0" IsVisible="{Binding HasDateChoice}"/>
                            <Picker Grid.Row="3" Grid.Column="1"
                                    ItemsSource="{Binding DateFormats}"
                                    SelectedItem="{Binding SelectedDateFormat}"
                                    ItemDisplayBinding="{Binding Pattern}"
                                    IsVisible="{Binding HasDateChoice}"
                                    Title="{ext:Localize ImportDateFormat}"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <Label Text="{ext:Localize ImportPositiveIsExpense}" FontSize="14" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" IsToggled="{Binding PositiveIsExpense}" VerticalOptions="Center"/>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                            <Label Text="{ext:Localize ImportExpenseCategory}" FontSize="14" FontAttributes="Bold"/>
                            <Picker Grid.Row="1"
                                    ItemsSource="{Binding ExpenseCategories}"
                                    SelectedItem="{Binding SelectedExpenseCategory}"
                                    ItemDisplayBinding="{Binding Name}"
                                    Title="{ext:Localize ImportExpenseCategory}"/>
                            <Label Grid.Column="1" Text="{ext:Localize ImportIncomeCategory}" FontSize="14" FontAttributes="Bold"/>
                            <Picker Grid.Row="1" Grid.Column="1"
                                    ItemsSource="{Binding IncomeCategories}"
                                    SelectedItem="{Binding SelectedIncomeCategory}"
                                    ItemDisplayBinding="{Binding Name}"
                                    Title="{ext:Localize ImportIncomeCategory}"/>
                        </Grid>
                        <Label Text="{ext:Localize ImportCategoryHint}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                            <Label Text="{Binding Summary}"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                               HeightRequest="20" WidthRequest="20"/>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ImportRow">
                    <Border Style="{StaticResource Card}" Margin="16,4" Padding="8,10,12,10">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <CheckBox IsChecked="{Binding IsIncluded}"
                                      IsEnabled="{Binding CanImport}"
                                      VerticalOptions="Center"/>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Description}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       LineBreakMode="TailTruncation"/>
                                <Label FontSize="12"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding DateText}"/>
                                            <Span Text="  "/>
                                            <Span Text="{Binding StatusText}"
                                                  FontAttributes="Bold"
                                                  TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                                <Label Text="{Binding AmountText}"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       HorizontalOptions="End"
                                       TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}"/>
                                <!-- The category: tap to change it -->
                                <Border Padding="8,2"
                                        HorizontalOptions="End"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        IsVisible="{Binding CanImport}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ImportStatementViewModel}}, Path=ChangeCategoryCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="&#xF02DA;"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="12"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding IsLearned}"
                                               SemanticProperties.Description="{ext:Localize ImportLearnedCategory}"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                        <Label Text="{Binding Category.Name}"
                                               FontSize="12"
                                               MaxLines="1"
                                               LineBreakMode="TailTruncation"
                                               MaximumWidthRequest="140"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsIncluded}" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </DataTrigger>
                        </Border.Triggers>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <ContentView HeightRequest="12"/>
            </CollectionView.Footer>
        </CollectionView>

        <Border Grid.Row="1"
                Padding="16,10"
                StrokeThickness="0"
                IsVisible="{Binding HasFile}"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                Shadow="{Shadow Brush=Black, Offset='0,-2', Radius=6, Opacity=0.15}">
            <Button Text="{Binding ImportButtonText}"
                    Command="{Binding ImportCommand}"
                    HeightRequest="48"
                    CornerRadius="24"
                    FontAttributes="Bold"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
        </Border>
    </Grid>

</ContentPage>
