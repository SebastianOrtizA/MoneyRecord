<?xml version="1.0" encoding="utf-8" ?>
<!-- The Spending and Income reports (ExpenseReportPage / IncomeReportPage set the type): a donut of the category
     shares with the total in its middle, and the ranked list below it as the donut's legend (each row's dot is its
     slice colour, and the list doubles as the table view). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:helpers="clr-namespace:MoneyRecord.Helpers;assembly=MoneyRecord.Core"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MoneyRecord.Views.CategoryReportPage"
             x:DataType="viewmodels:CategoryReportViewModel"
             Title="{Binding Texts.Title}">

    <RefreshView IsRefreshing="{Binding IsLoading}"
                 Command="{Binding LoadReportDataCommand}">
        <CollectionView ItemsSource="{Binding Categories}" Margin="16,0">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="12" Padding="0,12,0,4">
                    <Picker ItemsSource="{Binding Periods}"
                            SelectedItem="{Binding SelectedPeriod}"
                            Title="{ext:Localize SelectPeriod}"
                            FontSize="16"
                            MinimumHeightRequest="44" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsCustomPeriodSelected}">
                        <DatePicker Date="{Binding CustomStartDate}"
                                    Format="{x:Static helpers:DateFormatter.MediumPattern}"
                                    FontSize="16"
                                    MinimumHeightRequest="44" />
                        <DatePicker Grid.Column="1"
                                    Date="{Binding CustomEndDate}"
                                    Format="{x:Static helpers:DateFormatter.MediumPattern}"
                                    FontSize="16"
                                    MinimumHeightRequest="44" />
                    </Grid>

                    <!-- Donut with the total in the middle -->
                    <Border Style="{StaticResource ChartCard}" IsVisible="{Binding HasData}" Padding="8">
                        <Grid HeightRequest="260">
                            <lvc:PieChart Series="{Binding Slices}"
                                          LegendPosition="Hidden"
                                          InitialRotation="-90"
                                          BackgroundColor="Transparent" />
                            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" InputTransparent="True">
                                <Label Text="{Binding Texts.TotalLabel}"
                                       FontSize="13"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                <Label Text="{Binding Total, Converter={StaticResource MoneyConverter}}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </CollectionView.Header>

            <!-- Ranked list: tap a row for its transactions -->
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CategoryAmount">
                    <Grid Padding="4,10" ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoryReportViewModel}}, Path=ShowCategoryDetailsCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <Border Grid.RowSpan="2"
                                WidthRequest="10"
                                HeightRequest="10"
                                StrokeThickness="0"
                                StrokeShape="Ellipse"
                                VerticalOptions="Center"
                                BackgroundColor="{Binding PaletteSlot, Converter={StaticResource PaletteSlotToColorConverter}}" />
                        <Label Grid.Column="1"
                               Text="{Binding DisplayIcon}"
                               FontFamily="MaterialDesignIcons"
                               FontSize="18"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        <Label Grid.Column="2"
                               Text="{Binding CategoryName}"
                               FontSize="15"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="3" VerticalOptions="Center" HorizontalTextAlignment="End">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding Amount, Converter={StaticResource MoneyConverter}}" FontSize="15" FontAttributes="Bold" />
                                    <Span Text="  " />
                                    <Span Text="{Binding PercentageText}"
                                          FontSize="13"
                                          TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                     Progress="{Binding Share}"
                                     ProgressColor="{Binding PaletteSlot, Converter={StaticResource PaletteSlotToColorConverter}}"
                                     BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"
                                     HeightRequest="4" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <VerticalStackLayout Padding="32,48"
                                     Spacing="12"
                                     IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="{Binding Texts.EmptyIcon}"
                           FontFamily="MaterialDesignIcons"
                           FontSize="56"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="{Binding Texts.NoData}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{Binding Texts.NoDataHint}"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </CollectionView.Footer>
        </CollectionView>
    </RefreshView>
</ContentPage>
