<?xml version="1.0" encoding="utf-8" ?>
<!-- The Expense and Income reports (ExpenseReportPage / IncomeReportPage set the type). Colours that differ by type
     are the styles below: expense by default, income through the IsIncome trigger (on the view model and on each
     CategoryAmount). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:helpers="clr-namespace:MoneyRecord.Helpers;assembly=MoneyRecord.Core"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:converters="clr-namespace:MoneyRecord.Converters"
             x:Class="MoneyRecord.Views.CategoryReportPage"
             x:DataType="viewmodels:CategoryReportViewModel"
             Title="{Binding Texts.Title}">

    <ContentPage.Resources>
        <converters:HeatmapColorConverter x:Key="HeatmapBackground" />
        <converters:HeatmapColorConverter x:Key="HeatmapText" Text="True" />

        <Style x:Key="TotalFrame" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#F44336, Dark=#EF5350}" />
            <Style.Triggers>
                <DataTrigger TargetType="Frame" Binding="{Binding IsIncome, x:DataType=viewmodels:CategoryReportViewModel}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}" />
                    <Setter Property="BorderColor" Value="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TotalLabel" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsIncome, x:DataType=viewmodels:CategoryReportViewModel}" Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#2E7D32, Dark=#C8E6C9}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TotalAmount" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsIncome, x:DataType=viewmodels:CategoryReportViewModel}" Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#388E3C, Dark=#66BB6A}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemIcon" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsIncome, x:DataType=models:CategoryAmount}" Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#388E3C, Dark=#66BB6A}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ItemPercentage" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsIncome, x:DataType=models:CategoryAmount}" Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#388E3C, Dark=#66BB6A}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinorBadge" TargetType="Frame">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF3E0, Dark=#E65100}" />
            <Style.Triggers>
                <DataTrigger TargetType="Frame" Binding="{Binding IsIncome, x:DataType=models:CategoryAmount}" Value="True">
                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MinorBadgeText" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#E65100, Dark=#FFE0B2}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding IsIncome, x:DataType=models:CategoryAmount}" Value="True">
                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>

    <Grid>
        <RefreshView IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadReportDataCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16,12" Spacing="16">

                <!-- Period Filter Section -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Texts.Analysis}"
                               FontSize="20"
                               FontAttributes="Bold"
                               HorizontalOptions="Start"/>

                        <Label Text="{Binding Texts.AnalysisHint}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                               HorizontalOptions="Start"/>

                        <!-- Period Selector -->
                        <Picker ItemsSource="{Binding Periods}"
                                SelectedItem="{Binding SelectedPeriod}"
                                Title="{ext:Localize SelectPeriod}"
                                FontSize="16"
                                MinimumHeightRequest="44"
                                HorizontalOptions="FillAndExpand"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"/>

                        <!-- Custom Date Range Selector -->
                        <VerticalStackLayout Spacing="12"
                                            IsVisible="{Binding IsCustomPeriodSelected}">
                            <Grid ColumnDefinitions="Auto,*"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="12">

                                <Label Grid.Row="0" Grid.Column="0"
                                       Text="{ext:Localize From}"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       MinimumWidthRequest="50"/>
                                <DatePicker Grid.Row="0" Grid.Column="1"
                                           Date="{Binding CustomStartDate}"
                                           Format="{x:Static helpers:DateFormatter.MediumPattern}"
                                           FontSize="16"
                                           MinimumHeightRequest="44"
                                           HorizontalOptions="FillAndExpand"
                                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"/>

                                <Label Grid.Row="1" Grid.Column="0"
                                       Text="{ext:Localize To}"
                                       FontSize="16"
                                       VerticalOptions="Center"
                                       MinimumWidthRequest="50"/>
                                <DatePicker Grid.Row="1" Grid.Column="1"
                                           Date="{Binding CustomEndDate}"
                                           Format="{x:Static helpers:DateFormatter.MediumPattern}"
                                           FontSize="16"
                                           MinimumHeightRequest="44"
                                           HorizontalOptions="FillAndExpand"
                                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"/>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Total -->
                        <Frame Style="{StaticResource TotalFrame}"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False"
                               IsVisible="{Binding HasData}">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="{Binding Texts.TotalLabel}"
                                       Style="{StaticResource TotalLabel}"
                                       FontSize="14"
                                       HorizontalOptions="Center"/>
                                <Label Text="{Binding Total, Converter={StaticResource MoneyConverter}}"
                                       Style="{StaticResource TotalAmount}"
                                       FontSize="28"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                </Frame>

                <!-- Empty State -->
                <VerticalStackLayout Padding="40"
                                    Spacing="12"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}">
                    <Label Text="{Binding Texts.EmptyIcon}"
                           FontFamily="MaterialDesignIcons"
                           FontSize="48"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    <Label Text="{Binding Texts.NoData}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    <Label Text="{Binding Texts.NoDataHint}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#999999, Dark=#888888}"/>
                </VerticalStackLayout>

                <!-- Heatmap Section -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding Texts.Heatmap}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Start"/>

                        <Label Text="{Binding Texts.HeatmapHint}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"
                               HorizontalOptions="Start"/>

                        <!-- Heatmap Grid - 3 columns -->
                        <CollectionView ItemsSource="{Binding Categories}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical"
                                                Span="3"
                                                HorizontalItemSpacing="8"
                                                VerticalItemSpacing="8"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryAmount">
                                    <Frame BackgroundColor="{Binding ., Converter={StaticResource HeatmapBackground}}"
                                           CornerRadius="8"
                                           Padding="8"
                                           HasShadow="False"
                                           HeightRequest="90">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoryReportViewModel}}, Path=ShowCategoryDetailsCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Frame.GestureRecognizers>
                                        <VerticalStackLayout Spacing="2"
                                                            VerticalOptions="Center"
                                                            HorizontalOptions="Center">
                                            <Label Text="{Binding DisplayIcon}"
                                                   FontFamily="MaterialDesignIcons"
                                                   FontSize="22"
                                                   TextColor="{Binding ., Converter={StaticResource HeatmapText}}"
                                                   HorizontalOptions="Center"/>
                                            <Label Text="{Binding CategoryName}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding ., Converter={StaticResource HeatmapText}}"
                                                   HorizontalOptions="Center"
                                                   HorizontalTextAlignment="Center"
                                                   LineBreakMode="TailTruncation"
                                                   MaxLines="1"/>
                                            <Label Text="{Binding PercentageText}"
                                                   FontSize="14"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding ., Converter={StaticResource HeatmapText}}"
                                                   HorizontalOptions="Center"/>
                                        </VerticalStackLayout>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- Legend -->
                        <HorizontalStackLayout Spacing="8"
                                              HorizontalOptions="Center"
                                              Margin="0,8,0,0">
                            <Frame BackgroundColor="{Binding Type, Converter={StaticResource HeatmapBackground}, ConverterParameter=Low}"
                                   BorderColor="#E0E0E0"
                                   CornerRadius="4"
                                   Padding="8,4"
                                   HasShadow="False">
                                <Label Text="{ext:Localize Low}" FontSize="10"
                                       TextColor="{Binding Type, Converter={StaticResource HeatmapText}, ConverterParameter=Low}"/>
                            </Frame>
                            <Label Text="&#xF0142;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <Frame BackgroundColor="{Binding Type, Converter={StaticResource HeatmapBackground}, ConverterParameter=Medium}"
                                   CornerRadius="4"
                                   Padding="8,4"
                                   HasShadow="False">
                                <Label Text="{ext:Localize Medium}" FontSize="10"
                                       TextColor="{Binding Type, Converter={StaticResource HeatmapText}, ConverterParameter=Medium}"/>
                            </Frame>
                            <Label Text="&#xF0142;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="14"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <Frame BackgroundColor="{Binding Type, Converter={StaticResource HeatmapBackground}, ConverterParameter=High}"
                                   CornerRadius="4"
                                   Padding="8,4"
                                   HasShadow="False">
                                <Label Text="{ext:Localize High}" FontSize="10"
                                       TextColor="{Binding Type, Converter={StaticResource HeatmapText}, ConverterParameter=High}"/>
                            </Frame>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Frame>

                <!-- Category Details Section -->
                <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                       CornerRadius="12"
                       Padding="16"
                       HasShadow="True"
                       IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{ext:Localize CategoryDetails}"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Start"/>

                        <CollectionView ItemsSource="{Binding Categories}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryAmount">
                                    <Frame Margin="0,4"
                                           Padding="12"
                                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                           BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                                           CornerRadius="8"
                                           HasShadow="False">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CategoryReportViewModel}}, Path=ShowCategoryDetailsCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Frame.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                              ColumnSpacing="12">

                                            <!-- Color indicator -->
                                            <BoxView Grid.Column="0"
                                                     WidthRequest="4"
                                                     HeightRequest="40"
                                                     CornerRadius="2"
                                                     BackgroundColor="{Binding ., Converter={StaticResource HeatmapBackground}}"
                                                     VerticalOptions="Center"/>

                                            <!-- Category Icon and Name -->
                                            <HorizontalStackLayout Grid.Column="1"
                                                                  Spacing="8"
                                                                  VerticalOptions="Center">
                                                <Label Text="{Binding DisplayIcon}"
                                                       Style="{StaticResource ItemIcon}"
                                                       FontFamily="MaterialDesignIcons"
                                                       FontSize="20"
                                                       VerticalOptions="Center"/>
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding CategoryName}"
                                                           FontSize="15"
                                                           FontAttributes="Bold"
                                                           LineBreakMode="TailTruncation"/>
                                                    <HorizontalStackLayout Spacing="4">
                                                        <Label Text="{Binding Amount, Converter={StaticResource MoneyConverter}}"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                                        <Label Text="{ext:Localize TapForDetails}"
                                                               FontSize="10"
                                                               TextColor="{AppThemeBinding Light=#999999, Dark=#777777}"/>
                                                    </HorizontalStackLayout>
                                                </VerticalStackLayout>
                                            </HorizontalStackLayout>

                                            <!-- Badge for shares under 10% -->
                                            <Frame Grid.Column="2"
                                                   Style="{StaticResource MinorBadge}"
                                                   BorderColor="Transparent"
                                                   CornerRadius="10"
                                                   Padding="8,4"
                                                   HasShadow="False"
                                                   VerticalOptions="Center"
                                                   IsVisible="{Binding IsMinorShare}">
                                                <Label Text="&lt;10%"
                                                       Style="{StaticResource MinorBadgeText}"
                                                       FontSize="10"/>
                                            </Frame>

                                            <!-- Percentage -->
                                            <Label Grid.Column="3"
                                                   Text="{Binding PercentageText}"
                                                   Style="{StaticResource ItemPercentage}"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"/>
                                        </Grid>
                                    </Frame>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Frame>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Floating Action Menu -->
        <controls:FloatingActionMenu />
    </Grid>
</ContentPage>
