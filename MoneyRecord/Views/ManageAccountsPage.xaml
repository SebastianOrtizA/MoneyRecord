<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:behaviors="clr-namespace:MoneyRecord.Behaviors"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.ManageAccountsPage"
             x:DataType="viewmodels:ManageAccountsViewModel"
             Title="{ext:Localize ManageAccounts}">
    <Grid RowDefinitions="Auto,*">
        <VerticalStackLayout>
            <!-- Currency filter from a Home balance line -->
            <Border IsVisible="{Binding HasCurrencyFilter}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 18"
                    Padding="14,4,4,4"
                    Margin="16,12,16,0"
                    HorizontalOptions="Start"
                    BackgroundColor="{AppThemeBinding Light=#EDE7F6, Dark=#311B92}">
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding CurrencyFilterText}"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#311B92, Dark=#EDE7F6}" />
                    <Button Text="{ext:Localize ShowAllAccounts}"
                            Command="{Binding ClearCurrencyFilterCommand}"
                            FontSize="13"
                            Padding="12,0"
                            MinimumHeightRequest="32"
                            CornerRadius="16" />
                </HorizontalStackLayout>
            </Border>
            <!-- Only on a long list (more than 8 rows) -->
            <SearchBar Placeholder="{ext:Localize SearchAccounts}"
                       Text="{Binding SearchText}"
                       IsVisible="{Binding ShowSearch}"
                       Margin="16,8,16,0"
                       FontSize="14"
                       HeightRequest="44"
                       BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}" />
        </VerticalStackLayout>

        <!-- Accounts grouped by currency (base first); a tap opens the edit sheet -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Groups}"
                        IsGrouped="True">

            <CollectionView.GroupHeaderTemplate>
                <DataTemplate x:DataType="models:AccountGroup">
                    <Label Text="{Binding HeaderText}"
                           Margin="20,20,16,4"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:AccountListItem">
                    <Border Style="{StaticResource Card}" Margin="16,4" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ManageAccountsViewModel}}, Path=EditAccountCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="Ellipse"
                                    VerticalOptions="Center"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                <Label Text="{Binding Account.DisplayIcon}"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Account.Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />
                                    <Border StrokeThickness="0"
                                            StrokeShape="RoundRectangle 8"
                                            Padding="6,1"
                                            VerticalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}">
                                        <Label Text="{Binding CurrencyCode}"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Text="{Binding LastActivityText}"
                                       FontSize="12"
                                       LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            </VerticalStackLayout>

                            <Label Grid.Column="2"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{Binding CurrentBalance, Converter={StaticResource BalanceToColorConverter}}">
                                <Label.Text>
                                    <MultiBinding Converter="{StaticResource CurrencyMoneyConverter}" ConverterParameter="BesideCode">
                                        <Binding Path="CurrentBalance" />
                                        <Binding Path="CurrencyCode" />
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                        </Grid>

                        <!-- Pockets: money set aside inside this account; a tap opens the pocket -->
                        <VerticalStackLayout IsVisible="{Binding HasPockets}" Spacing="4" Margin="56,0,0,0">
                            <Label Text="{Binding AvailableText}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding IsOverCommitted}" Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Pockets}" Spacing="2">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:PocketSummary">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" MinimumHeightRequest="36">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ManageAccountsViewModel}}, Path=EditPocketCommand}"
                                                                      CommandParameter="{Binding .}" />
                                            </Grid.GestureRecognizers>
                                            <Label Text="{Binding DisplayIcon}"
                                                   FontFamily="MaterialDesignIcons"
                                                   FontSize="18"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding Pocket.Name}"
                                                   FontSize="14"
                                                   VerticalOptions="Center"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2"
                                                   Text="{Binding BalanceText}"
                                                   FontSize="14"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center">
                    <Label Text="&#xF0070;"
                           FontFamily="MaterialDesignIcons"
                           FontSize="48"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <Label Text="{Binding EmptyText}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <!-- Room so the last card scrolls above the add button -->
                <ContentView HeightRequest="88" />
            </CollectionView.Footer>
        </CollectionView>

        <Button Grid.RowSpan="2"
                Text="&#xF0415;"
                FontFamily="MaterialDesignIcons"
                FontSize="28"
                WidthRequest="60"
                MinimumHeightRequest="60"
                CornerRadius="30"
                Padding="0"
                Margin="0,0,16,16"
                HorizontalOptions="End"
                VerticalOptions="End"
                SemanticProperties.Description="{ext:Localize AddAccountButton}"
                IsVisible="{Binding IsSheetOpen, Converter={StaticResource InvertedBoolConverter}}"
                Command="{Binding AddAccountCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.35}" />

        <!-- Add / edit sheet -->
        <controls:BottomSheet Scroll="{x:Reference FormScroll}"
                              Grid.RowSpan="2"
                              IsOpen="{Binding IsFormOpen}"
                              CloseCommand="{Binding CloseFormCommand}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Label Text="{Binding FormTitle}" FontSize="18" FontAttributes="Bold" />

                <ScrollView Grid.Row="1" x:Name="FormScroll">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{ext:Localize AccountName}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        <Entry Text="{Binding FormName}"
                               Placeholder="{ext:Localize AccountNamePlaceholder}"
                               FontSize="16" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" Margin="0,4,0,0">
                            <Label Text="{ext:Localize InitialBalance}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            <Label Grid.Column="1" Text="{ext:Localize Currency}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            <controls:DecimalEntry Grid.Row="1"
                                                   Text="{Binding FormBalance}"
                                                   AllowNegative="{Binding FormAllowNegativeBalance}"
                                                   Placeholder="0.00"
                                                   FontSize="16">
                                <controls:DecimalEntry.Behaviors>
                                    <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding FormCurrency.Code}" AllowNegativeValues="{Binding FormAllowNegativeBalance}" />
                                </controls:DecimalEntry.Behaviors>
                            </controls:DecimalEntry>
                            <Picker Grid.Row="1" Grid.Column="1"
                                    ItemsSource="{Binding AvailableCurrencies}"
                                    SelectedItem="{Binding FormCurrency}"
                                    Title="{ext:Localize SelectCurrency}"
                                    FontSize="16"
                                    MinimumHeightRequest="44" />
                        </Grid>

                        <HorizontalStackLayout Spacing="8">
                            <CheckBox IsChecked="{Binding FormAllowNegativeBalance}"
                                      Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            <Label Text="{ext:Localize AllowNegativeBalance}"
                                   FontSize="14"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="{ext:Localize SelectIcon}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        <FlexLayout Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding AvailableIcons}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AccountIcon">
                                    <Border StrokeThickness="3"
                                            Padding="10"
                                            Margin="4"
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToSelectedBackgroundConverter}}">
                                        <Border.Stroke>
                                            <SolidColorBrush Color="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}" />
                                        </Border.Stroke>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ManageAccountsViewModel}}, Path=SelectIconCommand}"
                                                                  CommandParameter="{Binding Code}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding DisplayIcon}"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding IsSelected, Converter={StaticResource BoolToIconColorConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Delete only for an existing, non-default account -->
                <VerticalStackLayout Grid.Row="2" Spacing="8">
                    <Button Text="{ext:Localize NewPocket}"
                            IsVisible="{Binding IsEditMode}"
                            Command="{Binding NewPocketCommand}"
                            MinimumHeightRequest="44"
                            CornerRadius="22"
                            BorderWidth="1"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Grid ColumnDefinitions="Auto,*">
                        <Button Text="{ext:Localize DeleteButton}"
                                IsVisible="{Binding CanDelete}"
                                Command="{Binding DeleteAccountCommand}"
                                Margin="0,0,12,0"
                                MinimumHeightRequest="44"
                                Padding="20,0"
                                CornerRadius="22"
                                BorderWidth="1"
                                BackgroundColor="Transparent"
                                BorderColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                        <Button Grid.Column="1"
                                Text="{Binding SaveText}"
                                Command="{Binding SaveAccountCommand}"
                                MinimumHeightRequest="44"
                                CornerRadius="22"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </Grid>
                </VerticalStackLayout>
            </Grid>
        </controls:BottomSheet>

        <!-- Pocket sheet: name + icon, then set aside / take out, the last movements and Delete -->
        <controls:BottomSheet Scroll="{x:Reference PocketScroll}"
                              Grid.RowSpan="2"
                              BindingContext="{Binding PocketSheet}"
                              x:DataType="viewmodels:PocketSheetViewModel"
                              IsOpen="{Binding IsOpen}"
                              CloseCommand="{Binding CloseCommand}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Label Text="{Binding Title}" FontSize="18" FontAttributes="Bold" />

                <ScrollView Grid.Row="1" x:Name="PocketScroll">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{ext:Localize PocketName}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        <Entry Text="{Binding Name}"
                               Placeholder="{ext:Localize PocketNamePlaceholder}"
                               FontSize="16" />

                        <Label Text="{ext:Localize SelectIcon}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        <FlexLayout Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding Icons}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:AccountIcon">
                                    <Border StrokeThickness="3"
                                            Padding="10"
                                            Margin="4"
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToSelectedBackgroundConverter}}">
                                        <Border.Stroke>
                                            <SolidColorBrush Color="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}" />
                                        </Border.Stroke>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PocketSheetViewModel}}, Path=SelectIconCommand}"
                                                                  CommandParameter="{Binding Code}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding DisplayIcon}"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding IsSelected, Converter={StaticResource BoolToIconColorConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Money moves only once the pocket exists -->
                        <VerticalStackLayout IsVisible="{Binding IsEdit}" Spacing="8" Margin="0,8,0,0">
                            <Label Text="{Binding HoldsText}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding AvailableText}" FontSize="13" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            <controls:DecimalEntry Text="{Binding Amount}"
                                                   Placeholder="0.00"
                                                   FontSize="16">
                                <controls:DecimalEntry.Behaviors>
                                    <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding CurrencyCode}" />
                                </controls:DecimalEntry.Behaviors>
                            </controls:DecimalEntry>
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                <Button Text="{ext:Localize SetAside}"
                                        Command="{Binding SetAsideCommand}"
                                        MinimumHeightRequest="44"
                                        CornerRadius="22"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                <Button Grid.Column="1"
                                        Text="{ext:Localize TakeOut}"
                                        Command="{Binding TakeOutCommand}"
                                        MinimumHeightRequest="44"
                                        CornerRadius="22"
                                        BorderWidth="1"
                                        BackgroundColor="Transparent"
                                        BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                        TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Grid>

                            <Label Text="{ext:Localize PocketMovements}" FontSize="14" Margin="0,8,0,0" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            <Label Text="{ext:Localize NoPocketMovements}"
                                   IsVisible="{Binding HasMovements, Converter={StaticResource InvertedBoolConverter}}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Movements}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:PocketMovementRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <VerticalStackLayout>
                                                <Label Text="{Binding Title}" FontSize="14" />
                                                <Label Text="{Binding DetailText}" FontSize="12" LineBreakMode="TailTruncation"
                                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Text="{Binding AmountText}"
                                                   FontSize="14"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                    <Button Text="{ext:Localize DeleteButton}"
                            IsVisible="{Binding IsEdit}"
                            Command="{Binding DeleteCommand}"
                            Margin="0,0,12,0"
                            MinimumHeightRequest="44"
                            Padding="20,0"
                            CornerRadius="22"
                            BorderWidth="1"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                    <Button Grid.Column="1"
                            Text="{Binding SaveText}"
                            Command="{Binding SaveCommand}"
                            MinimumHeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                </Grid>
            </Grid>
        </controls:BottomSheet>
    </Grid>

</ContentPage>
