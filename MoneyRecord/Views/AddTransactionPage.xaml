<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:behaviors="clr-namespace:MoneyRecord.Behaviors"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.AddTransactionPage"
             Shell.TabBarIsVisible="False"
             x:DataType="viewmodels:AddTransactionViewModel"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}"/>
    </Shell.BackButtonBehavior>

    <!-- Fast entry: amount → payee → category → account → date; the rest under "More details"; Save stays at the bottom -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView x:Name="FormScroll">
            <VerticalStackLayout Padding="20" Spacing="16">

                <!-- The amount, centred; the scan button beside it reads a receipt photo's total and date -->
                <Grid ColumnDefinitions="44,*,44" ColumnSpacing="8">
                    <controls:DecimalEntry x:Name="AmountEntry"
                                           Grid.Column="1"
                                           Text="{Binding Amount}"
                                           Placeholder="{Binding AmountPlaceholder}"
                                           FontSize="32"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           SemanticProperties.Description="{ext:Localize Amount}">
                        <controls:DecimalEntry.Behaviors>
                            <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding SelectedAccount.CurrencyCode}"/>
                        </controls:DecimalEntry.Behaviors>
                    </controls:DecimalEntry>
                    <Button Grid.Column="2"
                            Text="&#xF19DC;"
                            FontFamily="MaterialDesignIcons"
                            FontSize="24"
                            HeightRequest="44"
                            WidthRequest="44"
                            Padding="0"
                            CornerRadius="22"
                            VerticalOptions="Center"
                            IsVisible="{Binding CanScanReceipt}"
                            Command="{Binding ScanReceiptCommand}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=White}"
                            SemanticProperties.Description="{ext:Localize ScanReceipt}"
                            ToolTipProperties.Text="{ext:Localize ScanReceipt}"/>
                </Grid>
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" IsVisible="{Binding IsReadingReceipt}">
                    <ActivityIndicator IsRunning="{Binding IsReadingReceipt}" HeightRequest="20" WidthRequest="20"/>
                    <Label Text="{ext:Localize ReadingReceipt}" FontSize="14" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                </HorizontalStackLayout>

                <!-- Payee (optional): earlier payees are suggested; tapping one picks the category it had last time -->
                <Label Text="{ext:Localize Payee}" FontSize="16" FontAttributes="Bold"/>
                <VerticalStackLayout Spacing="8">
                    <Entry Text="{Binding PayeeText}"
                           Placeholder="{ext:Localize PayeePlaceholder}"
                           ClearButtonVisibility="WhileEditing"
                           FontSize="16">
                        <Entry.Keyboard>
                            <Keyboard x:FactoryMethod="Create">
                                <x:Arguments>
                                    <KeyboardFlags>CapitalizeWord</KeyboardFlags>
                                </x:Arguments>
                            </Keyboard>
                        </Entry.Keyboard>
                    </Entry>
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding PayeeSuggestions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PayeeSummary">
                                <Border Margin="0,0,8,8"
                                        Padding="12,6"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddTransactionViewModel}}, Path=SelectPayeeCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="&#xF04DC;"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="16"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                        <Label Text="{Binding Name}"
                                               FontSize="14"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- An active trip: its banner and the switch to leave this expense out of it; an ended trip shows read only -->
                <Border Style="{StaticResource Card}" Padding="12" IsVisible="{Binding HasTrip}">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="&#xF001D;" FontFamily="MaterialDesignIcons" FontSize="20" VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                            <Label Text="{Binding TripBannerText}" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{ext:Localize NotPartOfTrip}" VerticalOptions="Center"/>
                            <Switch Grid.Column="1" IsToggled="{Binding IsOutsideTrip}"
                                    OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
                <Label Text="{Binding TripInfoText}" FontSize="14" IsVisible="{Binding TripInfoText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"/>

                <!-- Category grid, recently used first -->
                <Label Text="{ext:Localize Category}" FontSize="16" FontAttributes="Bold"/>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CategoryChoices}"
                            IsVisible="{Binding IsSplit, Converter={StaticResource InvertedBoolConverter}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:CategoryChoice">
                            <Border FlexLayout.Basis="{x:Static controls:ScaledLayout.CategoryBasis}"
                                    Padding="4,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource SelectedDark}}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddTransactionViewModel}}, Path=SelectCategoryCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="Ellipse"
                                            HorizontalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                        <Label Text="{Binding Category.DisplayIcon}"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                    </Border>
                                    <!-- Two lines between words; a word too long for the cell shrinks instead of breaking -->
                                    <controls:AutoFitLabel Text="{Binding Category.Name}"
                                                           MaxFontSize="12"
                                                           MinFontSize="9"
                                                           MaxLines="2"
                                                           LineBreakMode="TailTruncation"
                                                           HorizontalOptions="Fill"
                                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Split: one expense across several categories; the parts replace the grid -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding CanSplit}">
                    <Label Text="{ext:Localize SplitPayment}" FontSize="16" VerticalOptions="Center"/>
                    <Switch Grid.Column="1"
                            IsToggled="{Binding IsSplit}"
                            OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                </Grid>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSplit}">
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SplitParts}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:SplitPartViewModel">
                                <Grid ColumnDefinitions="*,130,Auto" ColumnSpacing="8">
                                    <Picker ItemsSource="{Binding Categories}"
                                            SelectedItem="{Binding Category}"
                                            ItemDisplayBinding="{Binding Name, x:DataType=models:Category}"
                                            Title="{ext:Localize Category}"
                                            FontSize="16"/>
                                    <controls:DecimalEntry Grid.Column="1"
                                                           Text="{Binding Amount}"
                                                           Placeholder="0.00"
                                                           FontSize="16"
                                                           HorizontalTextAlignment="End"
                                                           SemanticProperties.Description="{ext:Localize Amount}">
                                        <controls:DecimalEntry.Behaviors>
                                            <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding CurrencyCode}"/>
                                        </controls:DecimalEntry.Behaviors>
                                    </controls:DecimalEntry>
                                    <!-- Hidden at two parts: fewer is no split (switch it off instead) -->
                                    <Button Grid.Column="2"
                                            Text="&#xF015A;"
                                            FontFamily="MaterialDesignIcons"
                                            FontSize="22"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddTransactionViewModel}}, Path=CanRemoveSplitParts}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddTransactionViewModel}}, Path=RemoveSplitPartCommand}"
                                            CommandParameter="{Binding .}"
                                            SemanticProperties.Description="{ext:Localize DeleteButton}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Button Text="{ext:Localize AddSplitPart}"
                                Command="{Binding AddSplitPartCommand}"
                                FontSize="14"
                                Padding="12,0"
                                MinimumHeightRequest="40"
                                CornerRadius="20"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <!-- What the parts still need to make the amount -->
                        <Label Grid.Column="1"
                               Text="{Binding SplitRemainingText}"
                               FontSize="14"
                               HorizontalTextAlignment="End"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    </Grid>
                </VerticalStackLayout>

                <!-- Budget Warning Banner -->
                <Border IsVisible="{Binding ShowBudgetWarning}"
                        BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#3E2723}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="#B85400"
                        StrokeThickness="1"
                        Padding="12">
                    <Label Text="{Binding BudgetWarningText}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"/>
                </Border>

                <Label Text="{ext:Localize Account}" FontSize="16" FontAttributes="Bold"/>
                <Picker ItemsSource="{Binding Accounts}"
                        SelectedItem="{Binding SelectedAccount}"
                        ItemDisplayBinding="{Binding Name}"
                        Title="{ext:Localize SelectAccount}"
                        FontSize="16"/>

                <Label Text="{Binding DateLabel}" FontSize="16" FontAttributes="Bold"/>
                <DatePicker Date="{Binding SelectedDate}"
                            MinimumDate="{Binding MinimumDate}"
                            IsEnabled="{Binding CanEditDate}"
                            Format="D"
                            FontSize="16"/>
                <!-- A future date: only the schedule is saved, or the entry counts in balances from that date -->
                <Label Text="{Binding FutureDateNote}"
                       FontSize="13"
                       IsVisible="{Binding FutureDateNote, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                <!-- More details: description (defaults to the category name), tags, receipt, recurrence -->
                <Grid x:Name="MoreDetailsHeader" ColumnDefinitions="*,Auto" Padding="0,8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleMoreDetailsCommand}" Tapped="OnMoreDetailsTapped"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{ext:Localize MoreDetails}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                    <Label Grid.Column="1"
                           Text="{Binding IsMoreDetailsOpen, Converter={StaticResource BoolToExpandIconConverter}}"
                           FontFamily="MaterialDesignIcons"
                           FontSize="20"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                </Grid>

                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsMoreDetailsOpen}">
                    <Label Text="{ext:Localize Description}" FontSize="16" FontAttributes="Bold"/>
                    <Entry Text="{Binding Description}"
                           Placeholder="{Binding DescriptionPlaceholder}"
                           FontSize="16"/>

                    <!-- What belongs to a recorded entry, not to a schedule -->
                    <VerticalStackLayout Spacing="16" IsVisible="{Binding ShowsEntryDetails}">
                        <Label Text="{ext:Localize Tags}" FontSize="16" FontAttributes="Bold"/>
                        <Entry Text="{Binding TagsText}"
                               Placeholder="{ext:Localize TagsPlaceholder}"
                               FontSize="16"/>

                        <!-- The user's own conversion into the base currency, when the account is in another one -->
                        <VerticalStackLayout Spacing="8" IsVisible="{Binding CanConvert}">
                            <Label Text="{Binding ConvertedAmountLabel}" FontSize="16" FontAttributes="Bold"/>
                            <Label Text="{Binding ConvertedAmountHint}" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <controls:DecimalEntry Text="{Binding ConvertedAmount}"
                                                   Placeholder="0.00"
                                                   FontSize="16">
                                <controls:DecimalEntry.Behaviors>
                                    <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding BaseCurrencyCode}"/>
                                </controls:DecimalEntry.Behaviors>
                            </controls:DecimalEntry>
                            <Label Text="{Binding ConvertedRateText}" FontSize="13"
                                   IsVisible="{Binding ConvertedRateText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>

                        <!-- Receipt Photo Section -->
                        <Label Text="{ext:Localize Receipt}" FontSize="16" FontAttributes="Bold"/>
                        <VerticalStackLayout Spacing="8">
                            <HorizontalStackLayout Spacing="10">
                                <Button Text="&#xF0100;"
                                        FontFamily="MaterialDesignIcons"
                                        Command="{Binding TakePhotoCommand}"
                                        SemanticProperties.Description="{ext:Localize TakePhoto}"
                                        FontSize="20"
                                        HeightRequest="44"
                                        WidthRequest="44"
                                        Padding="0"
                                        CornerRadius="8"
                                        BackgroundColor="#1976D2"
                                        TextColor="White"/>
                                <Button Text="&#xF02E9;"
                                        FontFamily="MaterialDesignIcons"
                                        Command="{Binding PickPhotoCommand}"
                                        SemanticProperties.Description="{ext:Localize ChoosePhoto}"
                                        FontSize="20"
                                        HeightRequest="44"
                                        WidthRequest="44"
                                        Padding="0"
                                        CornerRadius="8"
                                        BackgroundColor="#7B1FA2"
                                        TextColor="White"/>
                                <Button Text="&#xF0A7A;"
                                        FontFamily="MaterialDesignIcons"
                                        Command="{Binding RemovePhotoCommand}"
                                        SemanticProperties.Description="{ext:Localize RemovePhoto}"
                                        IsVisible="{Binding HasReceipt}"
                                        FontSize="20"
                                        HeightRequest="44"
                                        WidthRequest="44"
                                        Padding="0"
                                        CornerRadius="8"
                                        BackgroundColor="#D32F2F"
                                        TextColor="White"/>
                            </HorizontalStackLayout>
                            <Border IsVisible="{Binding HasReceipt}"
                                    StrokeShape="RoundRectangle 8"
                                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                    HeightRequest="200"
                                    HorizontalOptions="Start">
                                <Image Source="{Binding ReceiptPhotoPath}"
                                       Aspect="AspectFit"
                                       MaximumHeightRequest="200"/>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Make Recurring Section (only for new transactions) -->
                    <VerticalStackLayout Spacing="12"
                                         IsVisible="{Binding CanMakeRecurring}">
                        <!-- A schedule from the Recurring page is recurring already -->
                        <Grid ColumnDefinitions="*,Auto" Padding="0"
                              IsVisible="{Binding IsScheduleMode, Converter={StaticResource InvertedBoolConverter}}">
                            <Label Grid.Column="0"
                                   Text="{ext:Localize MakeRecurring}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsRecurring}"
                                    OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                        </Grid>

                        <!-- Variable amount: nothing is saved by itself; each due date waits to be entered -->
                        <VerticalStackLayout Spacing="4" IsVisible="{Binding IsScheduleMode}">
                            <Grid ColumnDefinitions="*,Auto" Padding="0">
                                <Label Grid.Column="0"
                                       Text="{ext:Localize AmountVaries}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding IsVariableAmount}"
                                        OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                            </Grid>
                            <Label Text="{ext:Localize AmountVariesHint}"
                                   FontSize="13"
                                   IsVisible="{Binding IsVariableAmount}"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        </VerticalStackLayout>
        
                        <VerticalStackLayout Spacing="12"
                                             IsVisible="{Binding IsRecurring}">
                            <Label Text="{ext:Localize Frequency}" FontSize="16" FontAttributes="Bold"/>
                            <Picker ItemsSource="{Binding Frequencies}"
                                    SelectedItem="{Binding SelectedFrequencyItem}"
                                    Title="{ext:Localize SelectFrequency}"
                                    FontSize="16"/>
        
                            <!-- Day of Month (only for Monthly) -->
                            <VerticalStackLayout Spacing="12"
                                                 IsVisible="{Binding IsMonthlyFrequency}">
                                <Grid ColumnDefinitions="*,Auto" Padding="0">
                                    <Label Grid.Column="0"
                                           Text="{ext:Localize SpecificDayOfMonth}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                    <Switch Grid.Column="1"
                                            IsToggled="{Binding UseSpecificDay}"
                                            OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                                </Grid>
                                <Picker ItemsSource="{Binding DaysOfMonth}"
                                        SelectedItem="{Binding SelectedDayOfMonth}"
                                        Title="{ext:Localize SelectDay}"
                                        FontSize="16"
                                        IsVisible="{Binding UseSpecificDay}"/>
                            </VerticalStackLayout>
        
                            <Grid ColumnDefinitions="*,Auto" Padding="0">
                                <Label Grid.Column="0"
                                       Text="{ext:Localize HasEndDate}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding HasEndDate}"
                                        OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                            </Grid>
                            <DatePicker Date="{Binding EndDate}"
                                        Format="D"
                                        FontSize="16"
                                        IsVisible="{Binding HasEndDate}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
        
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Always visible; back (the arrow or Android back) cancels -->
        <Border Grid.Row="1"
                Padding="20,12"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                Shadow="{Shadow Brush=Black, Offset='0,-2', Radius=6, Opacity=0.15}">
            <Button Text="{ext:Localize Save}"
                    Command="{Binding SaveCommand}"
                    MinimumHeightRequest="48"
                    CornerRadius="24"
                    FontAttributes="Bold"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
        </Border>
    </Grid>

</ContentPage>
