<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:behaviors="clr-namespace:MoneyRecord.Behaviors"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.AddTransactionPage"
             Shell.TabBarIsVisible="False"
             x:DataType="viewmodels:AddTransactionViewModel"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}"/>
    </Shell.BackButtonBehavior>

    <!-- Fast entry: amount → category → account → date; the rest under "More details"; Save stays at the bottom -->
    <Grid RowDefinitions="*,Auto">
        <ScrollView>
            <VerticalStackLayout Padding="20" Spacing="16">

                <controls:DecimalEntry x:Name="AmountEntry"
                                       Text="{Binding Amount}"
                                       Placeholder="0.00"
                                       FontSize="32"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       SemanticProperties.Description="{ext:Localize Amount}">
                    <controls:DecimalEntry.Behaviors>
                        <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding SelectedAccount.CurrencyCode}"/>
                    </controls:DecimalEntry.Behaviors>
                </controls:DecimalEntry>

                <!-- Category grid, recently used first -->
                <Label Text="{ext:Localize Category}" FontSize="16" FontAttributes="Bold"/>
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CategoryChoices}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:CategoryChoice">
                            <Border FlexLayout.Basis="25%"
                                    Padding="4,8"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="Transparent">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Secondary}, Dark=#3A3060}"/>
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:AddTransactionViewModel}}, Path=SelectCategoryCommand}"
                                                          CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <VerticalStackLayout Spacing="4">
                                    <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="Ellipse"
                                            HorizontalOptions="Center"
                                            BackgroundColor="{AppThemeBinding Light=#F0EDFA, Dark=#2D2840}">
                                        <Label Text="{Binding Category.DisplayIcon}"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                    </Border>
                                    <Label Text="{Binding Category.Name}"
                                           FontSize="12"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation"
                                           HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- Budget Warning Banner -->
                <Border IsVisible="{Binding ShowBudgetWarning}"
                        BackgroundColor="{AppThemeBinding Light=#FFF3E0, Dark=#3E2723}"
                        StrokeShape="RoundRectangle 8"
                        Stroke="{AppThemeBinding Light=#FF9800, Dark=#FF9800}"
                        StrokeThickness="1"
                        Padding="12">
                    <Label Text="{Binding BudgetWarningText}"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#E65100, Dark=#FFB74D}"/>
                </Border>

                <Label Text="{ext:Localize Account}" FontSize="16" FontAttributes="Bold"/>
                <Picker ItemsSource="{Binding Accounts}"
                        SelectedItem="{Binding SelectedAccount}"
                        ItemDisplayBinding="{Binding Name}"
                        Title="{ext:Localize SelectAccount}"
                        FontSize="16"/>

                <Label Text="{ext:Localize Date}" FontSize="16" FontAttributes="Bold"/>
                <DatePicker Date="{Binding SelectedDate}"
                            Format="D"
                            FontSize="16"/>

                <!-- More details: description (defaults to the category name), tags, receipt, recurrence -->
                <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleMoreDetailsCommand}"/>
                    </Grid.GestureRecognizers>
                    <Label Text="{ext:Localize MoreDetails}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                    <Label Grid.Column="1"
                           Text="{Binding IsMoreDetailsOpen, Converter={StaticResource BoolToExpandIconConverter}}"
                           FontFamily="MaterialDesignIcons"
                           FontSize="20"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                </Grid>

                <VerticalStackLayout Spacing="16" IsVisible="{Binding IsMoreDetailsOpen}">
                    <Label Text="{ext:Localize Description}" FontSize="16" FontAttributes="Bold"/>
                    <Entry Text="{Binding Description}"
                           Placeholder="{Binding SelectedCategory.Name}"
                           FontSize="16"/>

                    <Label Text="{ext:Localize Tags}" FontSize="16" FontAttributes="Bold"/>
                    <Entry Text="{Binding TagsText}"
                           Placeholder="{ext:Localize TagsPlaceholder}"
                           FontSize="16"/>

                    <!-- Receipt Photo Section -->
                    <Label Text="{ext:Localize Receipt}" FontSize="16" FontAttributes="Bold"/>
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="10">
                            <Button Text="&#xF0100;"
                                    FontFamily="MaterialDesignIcons"
                                    Command="{Binding TakePhotoCommand}"
                                    FontSize="20"
                                    HeightRequest="44"
                                    WidthRequest="44"
                                    Padding="0"
                                    CornerRadius="8"
                                    BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"
                                    TextColor="White"/>
                            <Button Text="&#xF02E9;"
                                    FontFamily="MaterialDesignIcons"
                                    Command="{Binding PickPhotoCommand}"
                                    FontSize="20"
                                    HeightRequest="44"
                                    WidthRequest="44"
                                    Padding="0"
                                    CornerRadius="8"
                                    BackgroundColor="{AppThemeBinding Light=#7B1FA2, Dark=#AB47BC}"
                                    TextColor="White"/>
                            <Button Text="&#xF0A7A;"
                                    FontFamily="MaterialDesignIcons"
                                    Command="{Binding RemovePhotoCommand}"
                                    IsVisible="{Binding HasReceipt}"
                                    FontSize="20"
                                    HeightRequest="44"
                                    WidthRequest="44"
                                    Padding="0"
                                    CornerRadius="8"
                                    BackgroundColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                                    TextColor="White"/>
                        </HorizontalStackLayout>
                        <Border IsVisible="{Binding HasReceipt}"
                                StrokeShape="RoundRectangle 8"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                                HeightRequest="200"
                                HorizontalOptions="Start">
                            <Image Source="{Binding ReceiptPhotoPath}"
                                   Aspect="AspectFit"
                                   MaximumHeightRequest="200"/>
                        </Border>
                    </VerticalStackLayout>
        

                    <!-- Make Recurring Section (only for new transactions) -->
                    <VerticalStackLayout Spacing="12"
                                         IsVisible="{Binding IsEditMode, Converter={StaticResource InvertedBoolConverter}}">
                        <Grid ColumnDefinitions="*,Auto" Padding="0">
                            <Label Grid.Column="0"
                                   Text="{ext:Localize MakeRecurring}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsRecurring}"
                                    OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                        </Grid>
        
                        <VerticalStackLayout Spacing="12"
                                             IsVisible="{Binding IsRecurring}">
                            <Label Text="{ext:Localize Frequency}" FontSize="16" FontAttributes="Bold"/>
                            <Picker ItemsSource="{Binding Frequencies}"
                                    SelectedItem="{Binding SelectedFrequencyItem}"
                                    Title="{ext:Localize SelectFrequency}"
                                    FontSize="16"/>
        
                            <!-- Day of Month (only for Monthly) -->
                            <VerticalStackLayout Spacing="12"
                                                 IsVisible="{Binding IsMonthlyFrequency}">
                                <Grid ColumnDefinitions="*,Auto" Padding="0">
                                    <Label Grid.Column="0"
                                           Text="{ext:Localize SpecificDayOfMonth}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"/>
                                    <Switch Grid.Column="1"
                                            IsToggled="{Binding UseSpecificDay}"
                                            OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                                </Grid>
                                <Picker ItemsSource="{Binding DaysOfMonth}"
                                        SelectedItem="{Binding SelectedDayOfMonth}"
                                        Title="{ext:Localize SelectDay}"
                                        FontSize="16"
                                        IsVisible="{Binding UseSpecificDay}"/>
                            </VerticalStackLayout>
        
                            <Grid ColumnDefinitions="*,Auto" Padding="0">
                                <Label Grid.Column="0"
                                       Text="{ext:Localize HasEndDate}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       VerticalOptions="Center"/>
                                <Switch Grid.Column="1"
                                        IsToggled="{Binding HasEndDate}"
                                        OnColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"/>
                            </Grid>
                            <DatePicker Date="{Binding EndDate}"
                                        Format="D"
                                        FontSize="16"
                                        IsVisible="{Binding HasEndDate}"/>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
        
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Always visible; back (the arrow or Android back) cancels -->
        <Border Grid.Row="1"
                Padding="20,12"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                Shadow="{Shadow Brush=Black, Offset='0,-2', Radius=6, Opacity=0.15}">
            <Button Text="{ext:Localize Save}"
                    Command="{Binding SaveCommand}"
                    HeightRequest="48"
                    CornerRadius="24"
                    FontAttributes="Bold"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
        </Border>
    </Grid>

</ContentPage>
