<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:behaviors="clr-namespace:MoneyRecord.Behaviors"
             x:Class="MoneyRecord.Views.PartyPage"
             x:DataType="viewmodels:PartyViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <Style x:Key="FormCaption" TargetType="Label">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
        </Style>
        <Style x:Key="SectionAddButton" TargetType="Button">
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <RefreshView IsRefreshing="{Binding IsLoading}" Command="{Binding LoadCommand}">
            <ScrollView>
                <VerticalStackLayout Padding="16" Spacing="12" IsVisible="{Binding HasParty}">
                    <!-- Summary -->
                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Card.DateText}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            <Label Text="{Binding Card.SpentText}" FontSize="20" FontAttributes="Bold" />
                            <ProgressBar IsVisible="{Binding Card.HasBudget}"
                                         Progress="{Binding Card.ProgressPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                         ProgressColor="{Binding Card.Level, Converter={StaticResource BudgetLevelToColorConverter}}"
                                         BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                         HeightRequest="10" />
                            <Label Text="{Binding Card.StatusText}" IsVisible="{Binding Card.HasBudget}" FontSize="13" FontAttributes="Bold"
                                   TextColor="{Binding Card.Level, Converter={StaticResource BudgetLevelToColorConverter}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Balances -->
                    <Label Text="{ext:Localize PartyBalances}" FontSize="16" FontAttributes="Bold" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Balances}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PartyBalanceRow">
                                <Border Style="{StaticResource Card}" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding DetailsText}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding BalanceText}" FontSize="14" FontAttributes="Bold" VerticalOptions="Center">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsOwed}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource IncomeColor}, Dark={StaticResource IncomeColorDark}}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Label" Binding="{Binding Owes}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Settle up: who still pays whom, and what was paid -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="{ext:Localize PartySettleUp}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{ext:Localize SharePartySummary}" Command="{Binding ShareCommand}" Style="{StaticResource SectionAddButton}" />
                    </Grid>
                    <Label Text="{ext:Localize PartyAllSettled}" IsVisible="{Binding IsSettled}" FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding SettleRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PartySettleRow">
                                <Border Style="{StaticResource Card}" Padding="12">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Text}" FontSize="15" VerticalOptions="Center" />
                                        <Button Grid.Column="1" Text="{ext:Localize PartyMarkPaid}" Style="{StaticResource SectionAddButton}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PartyViewModel}}, Path=MarkPaidCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{ext:Localize PartyPaymentsMade}" IsVisible="{Binding HasPayments}" FontSize="14" FontAttributes="Bold" Margin="0,4,0,0" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Payments}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PartyPaymentRow">
                                <Border Style="{StaticResource Card}" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PartyViewModel}}, Path=OpenPaymentCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="15" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Details}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Expenses -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="{ext:Localize PartyExpenses}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{ext:Localize AddPartyExpense}" Command="{Binding AddExpenseCommand}" Style="{StaticResource SectionAddButton}" />
                    </Grid>
                    <Label Text="{ext:Localize NoPartyExpenses}" IsVisible="{Binding HasNoExpenses}" FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Expenses}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PartyExpenseRow">
                                <Border Style="{StaticResource Card}" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PartyViewModel}}, Path=OpenExpenseCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="15" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Details}" FontSize="12" LineBreakMode="TailTruncation"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding AmountText}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Contributions to the pot -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                        <Label Text="{ext:Localize PartyContributions}" FontSize="16" FontAttributes="Bold" VerticalOptions="Center" />
                        <Button Grid.Column="1" Text="{ext:Localize AddPartyContribution}" Command="{Binding AddContributionCommand}" Style="{StaticResource SectionAddButton}" />
                    </Grid>
                    <Label Text="{ext:Localize NoPartyContributions}" IsVisible="{Binding HasNoContributions}" FontSize="14"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Contributions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PartyContributionRow">
                                <Border Style="{StaticResource Card}" Padding="12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PartyViewModel}}, Path=OpenContributionCommand}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" FontSize="15" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding Details}" FontSize="12"
                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="1" Text="{Binding AmountText}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource IncomeColor}, Dark={StaticResource IncomeColorDark}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Button Text="{Binding RecordShareText}" Command="{Binding RecordMyShareCommand}" Margin="0,8,0,0"
                            HeightRequest="44" CornerRadius="22" BorderWidth="1" BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <Button Text="{ext:Localize Edit}" Command="{Binding EditCommand}"
                                HeightRequest="44" CornerRadius="22"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                        <Button Grid.Column="1" Text="{ext:Localize DeleteButton}" Command="{Binding DeleteCommand}"
                                HeightRequest="44" CornerRadius="22" BorderWidth="1" BackgroundColor="Transparent"
                                BorderColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}"
                                TextColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Expense: description, amount, date, who paid, who shares it -->
        <controls:BottomSheet Scroll="{x:Reference ExpenseScroll}" IsOpen="{Binding IsExpenseSheetOpen}" CloseCommand="{Binding CloseExpenseSheetCommand}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Label Text="{Binding ExpenseSheetTitle}" FontSize="18" FontAttributes="Bold" />

                <ScrollView Grid.Row="1" x:Name="ExpenseScroll">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{ext:Localize Description}" Style="{StaticResource FormCaption}" />
                        <Entry Text="{Binding ExpenseDescription}" MaxLength="60" FontSize="16" />

                        <Label Text="{ext:Localize Amount}" Style="{StaticResource FormCaption}" />
                        <controls:DecimalEntry Text="{Binding ExpenseAmount}" Placeholder="0.00" FontSize="16">
                            <controls:DecimalEntry.Behaviors>
                                <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding CurrencyCode}" />
                            </controls:DecimalEntry.Behaviors>
                        </controls:DecimalEntry>

                        <Label Text="{ext:Localize Date}" Style="{StaticResource FormCaption}" />
                        <DatePicker Date="{Binding ExpenseDate}" Format="D" FontSize="16" />

                        <Label Text="{ext:Localize PartyPaidBy}" Style="{StaticResource FormCaption}" />
                        <Picker ItemsSource="{Binding PayerChoices}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedPayer}"
                                FontSize="16" MinimumHeightRequest="44" />

                        <Label Text="{ext:Localize PartySharedBetween}" Style="{StaticResource FormCaption}" Margin="0,8,0,0" />
                        <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding SharerChoices}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:PartyMemberChoice">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" MinimumHeightRequest="44">
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center"
                                                  Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Label Grid.Column="1" Text="{Binding Participant.Name}" FontSize="16" VerticalOptions="Center" LineBreakMode="TailTruncation" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="2" Text="{ext:Localize Save}" Command="{Binding SaveExpenseCommand}"
                        HeightRequest="44" CornerRadius="22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
            </Grid>
        </controls:BottomSheet>

        <!-- Contribution: who handed in how much -->
        <controls:BottomSheet Scroll="{x:Reference ContributionScroll}" IsOpen="{Binding IsContributionSheetOpen}" CloseCommand="{Binding CloseContributionSheetCommand}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Label Text="{Binding ContributionSheetTitle}" FontSize="18" FontAttributes="Bold" />

                <ScrollView Grid.Row="1" x:Name="ContributionScroll">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{ext:Localize PartyWho}" Style="{StaticResource FormCaption}" />
                        <Picker ItemsSource="{Binding MemberChoices}" ItemDisplayBinding="{Binding Name}" SelectedItem="{Binding SelectedContributor}"
                                FontSize="16" MinimumHeightRequest="44" />

                        <Label Text="{ext:Localize Amount}" Style="{StaticResource FormCaption}" />
                        <controls:DecimalEntry Text="{Binding ContributionAmount}" Placeholder="0.00" FontSize="16">
                            <controls:DecimalEntry.Behaviors>
                                <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding CurrencyCode}" />
                            </controls:DecimalEntry.Behaviors>
                        </controls:DecimalEntry>

                        <Label Text="{ext:Localize Date}" Style="{StaticResource FormCaption}" />
                        <DatePicker Date="{Binding ContributionDate}" Format="D" FontSize="16" />
                    </VerticalStackLayout>
                </ScrollView>

                <Button Grid.Row="2" Text="{ext:Localize Save}" Command="{Binding SaveContributionCommand}"
                        HeightRequest="44" CornerRadius="22"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                        TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
            </Grid>
        </controls:BottomSheet>
    </Grid>

</ContentPage>
