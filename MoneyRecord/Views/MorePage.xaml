<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.MorePage"
             x:DataType="viewmodels:MoreViewModel"
             Title="{ext:Localize More}">

    <ScrollView>
        <VerticalStackLayout Padding="0,8" BindableLayout.ItemsSource="{Binding Items}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:MoreItem">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Padding="20,14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MoreViewModel}}, Path=OpenCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding Icon}"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <Label Grid.Column="1" Text="{Binding Title}" FontSize="16" VerticalOptions="Center"/>
                        <Label Grid.Column="2"
                               Text="&#xF0142;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="22"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"/>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
