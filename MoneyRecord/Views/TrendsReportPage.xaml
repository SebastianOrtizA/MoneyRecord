<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MoneyRecord.Views.TrendsReportPage"
             x:DataType="viewmodels:TrendsReportViewModel"
             Title="{ext:Localize Trends}">

    <ContentPage.Resources>
        <Style x:Key="ChartCard" TargetType="Border">
            <Setter Property="Padding" Value="12" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 12" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E0E0E0, Dark=#404040}" />
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}" />
        </Style>
    </ContentPage.Resources>

    <RefreshView IsRefreshing="{Binding IsLoading}"
                 Command="{Binding LoadChartsCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="16">

                <!-- How many months -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Text="{ext:Localize TrendsAnalysis}"
                           FontSize="18"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding MonthCountOptions}"
                            SelectedItem="{Binding SelectedMonthCount}"
                            FontSize="16"
                            MinimumWidthRequest="80" />
                </Grid>

                <!-- Empty state -->
                <VerticalStackLayout IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}"
                                     Padding="32,48" Spacing="12">
                    <Label Text="&#xF0127;"
                           FontFamily="MaterialDesignIcons"
                           FontSize="56"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="{ext:Localize NoTrendsData}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{ext:Localize AddTransactionsForTrends}"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>

                <!-- One series: the title names it, so no legend -->
                <Border Style="{StaticResource ChartCard}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{ext:Localize MonthlySpending}" FontSize="16" FontAttributes="Bold" />
                        <lvc:CartesianChart HeightRequest="220"
                                            Series="{Binding SpendingSeries}"
                                            XAxes="{Binding MonthAxis}"
                                            YAxes="{Binding MoneyAxis}"
                                            LegendPosition="Hidden"
                                            BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

                <!-- Two series: legend on top -->
                <Border Style="{StaticResource ChartCard}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{ext:Localize IncomeVsExpenses}" FontSize="16" FontAttributes="Bold" />
                        <lvc:CartesianChart HeightRequest="240"
                                            Series="{Binding IncomeVsExpenseSeries}"
                                            XAxes="{Binding MonthAxis}"
                                            YAxes="{Binding MoneyAxis}"
                                            LegendPosition="Top"
                                            BackgroundColor="Transparent" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
