<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             x:Class="MoneyRecord.Views.TrendsReportPage"
             x:DataType="viewmodels:TrendsReportViewModel"
             Title="{ext:Localize Trends}">

    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="16">

                <!-- Period Selector -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <Label Grid.Column="0"
                           Text="{ext:Localize TrendsAnalysis}"
                           FontSize="20"
                           FontAttributes="Bold"
                           VerticalOptions="Center"/>
                    <Picker Grid.Column="1"
                            ItemsSource="{Binding MonthCountOptions}"
                            SelectedItem="{Binding SelectedMonthCount}"
                            FontSize="14"
                            MinimumWidthRequest="80"
                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"/>
                </Grid>

                <!-- Empty State -->
                <VerticalStackLayout IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}"
                                    Padding="40" Spacing="12" HorizontalOptions="Center">
                    <Label Text="&#xF0127;"
                           FontFamily="MaterialDesignIcons"
                           FontSize="48"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    <Label Text="{ext:Localize NoTrendsData}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    <Label Text="{ext:Localize AddTransactionsForTrends}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#999999, Dark=#888888}"/>
                </VerticalStackLayout>

                <!-- Charts (visible when data exists) -->
                <VerticalStackLayout IsVisible="{Binding HasData}" Spacing="16">

                    <!-- Monthly Spending Bar Chart -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{ext:Localize MonthlySpending}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <GraphicsView x:Name="MonthlyChart"
                                          HeightRequest="220"
                                          HorizontalOptions="Fill"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Income vs Expense Comparison -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{ext:Localize IncomeVsExpenses}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <GraphicsView x:Name="IncomeVsExpenseChart"
                                          HeightRequest="220"
                                          HorizontalOptions="Fill"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Category Breakdown Pie Chart -->
                    <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                           BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                           CornerRadius="12"
                           Padding="16"
                           HasShadow="True">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{ext:Localize ExpenseCategoryBreakdown}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                            <GraphicsView x:Name="CategoryPieChart"
                                          HeightRequest="320"
                                          HorizontalOptions="Fill"/>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Action Menu -->
        <controls:FloatingActionMenu />
    </Grid>

</ContentPage>
