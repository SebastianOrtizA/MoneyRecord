<?xml version="1.0" encoding="utf-8" ?>
<!-- Choosing an app PIN, typed twice on the PIN pad (IDialogService.SetPinAsync) -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:vm="clr-namespace:MoneyRecord.ViewModels;assembly=MoneyRecord.Core"
             x:Class="MoneyRecord.Views.PinSetupPage"
             x:DataType="vm:PinSetupViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="16" Padding="32">
            <Label Text="{Binding Title}"
                   FontSize="22"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1"
                   HorizontalTextAlignment="Center"/>
            <Label Text="{Binding Message}"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
            <Label Text="{Binding Error}"
                   MinimumHeightRequest="40"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#C62828, Dark=#EF9A9A}"/>
            <controls:PinPad HorizontalOptions="Center"/>
            <Button Text="{ext:Localize Cancel}"
                    Command="{Binding CancelCommand}"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                    HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
