<?xml version="1.0" encoding="utf-8" ?>
<!-- Cash flow: income and expense per month as lines over the shared "last N months", with the net as headline;
     a point opens that month's income or expenses -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:charts="clr-namespace:MoneyRecord.Charts"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MoneyRecord.Views.CashFlowReportPage"
             x:DataType="viewmodels:CashFlowReportViewModel"
             Title="{ext:Localize CashFlow}">

    <RefreshView IsRefreshing="{Binding IsLoading}"
                 Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="16">
                <controls:MonthCountPicker BindingContext="{Binding Period}" />

                <VerticalStackLayout IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}"
                                     Padding="32,48" Spacing="12">
                    <Label Text="&#xF0127;"
                           FontFamily="MaterialDesignIcons"
                           FontSize="56"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="{ext:Localize NoTrendsData}"
                           FontSize="18"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center" />
                    <Label Text="{ext:Localize AddTransactionsForTrends}"
                           FontSize="14"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>

                <Border Style="{StaticResource ChartCard}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{ext:Localize NetCashFlow}" Style="{StaticResource ReportHeadlineLabel}" />
                        <Label Text="{Binding Headline, Converter={StaticResource SignedMoneyConverter}}" Style="{StaticResource ReportHeadline}" />
                        <Label Text="{Binding DeltaText}" Style="{StaticResource ReportDelta}" />
                        <lvc:CartesianChart HeightRequest="260"
                                            Margin="0,8,0,0"
                                            Series="{Binding CashFlowSeries}"
                                            XAxes="{Binding MonthAxis}"
                                            YAxes="{Binding MoneyAxis}"
                                            LegendPosition="Top"
                                            BackgroundColor="Transparent">
                            <lvc:CartesianChart.Behaviors>
                                <charts:ChartTapBehavior />
                            </lvc:CartesianChart.Behaviors>
                        </lvc:CartesianChart>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
