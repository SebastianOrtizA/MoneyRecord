<?xml version="1.0" encoding="utf-8" ?>
<!-- Cash flow: income and expense per month as lines over the shared "last N months", with the net as headline;
     a point opens that month's income or expenses -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:charts="clr-namespace:MoneyRecord.Charts"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             x:Class="MoneyRecord.Views.CashFlowReportPage"
             x:DataType="viewmodels:CashFlowReportViewModel"
             Title="{ext:Localize CashFlow}">

    <!-- Export: a PDF report or the transactions (CSV) of the last N months ("Months" = ReportExportViewModel.Months) -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{ext:Localize ExportReport}"
                     IconImageSource="{StaticResource ExportIcon}"
                     Command="{Binding Export.ExportCommand}"
                     CommandParameter="Months" />
    </ContentPage.ToolbarItems>

    <RefreshView IsRefreshing="{Binding IsLoading}"
                 Command="{Binding LoadCommand}">
        <ScrollView>
            <VerticalStackLayout Padding="16,12" Spacing="16">
                <controls:MonthCountPicker BindingContext="{Binding Period}" />
                <controls:CurrencyChips BindingContext="{Binding Period}" />

                <controls:EmptyState IsVisible="{Binding HasData, Converter={StaticResource InvertedBoolConverter}}"
                                     Icon="&#xF0127;"
                                     Title="{ext:Localize NoCashFlowData}"
                                     Message="{ext:Localize AddForCashFlow}" />

                <Border Style="{StaticResource ChartCard}" IsVisible="{Binding HasData}">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{ext:Localize NetCashFlow}" Style="{StaticResource ReportHeadlineLabel}" />
                        <Label Text="{Binding HeadlineText}" Style="{StaticResource ReportHeadline}" />
                        <Label Text="{Binding DeltaText}" Style="{StaticResource ReportDelta}" />
                        <Label Text="{Binding NotConvertedText}" Style="{StaticResource ReportDelta}"
                               IsVisible="{Binding NotConvertedText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}" />
                        <lvc:CartesianChart HeightRequest="260"
                                            Margin="0,8,0,0"
                                            Series="{Binding CashFlowSeries}"
                                            XAxes="{Binding MonthAxis}"
                                            YAxes="{Binding MoneyAxis}"
                                            LegendPosition="Top"
                                            BackgroundColor="Transparent">
                            <lvc:CartesianChart.Behaviors>
                                <charts:ChartTapBehavior />
                            </lvc:CartesianChart.Behaviors>
                        </lvc:CartesianChart>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>
</ContentPage>
