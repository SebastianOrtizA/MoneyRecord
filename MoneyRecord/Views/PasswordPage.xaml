<?xml version="1.0" encoding="utf-8" ?>
<!-- Asks for a password, typed hidden (IDialogService.PasswordAsync): the page dialogs can't hide what is typed -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.PasswordPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Spacing="16" Padding="24,48,24,24">
            <Label Text="&#xF033E;"
                   FontFamily="MaterialDesignIcons"
                   FontSize="56"
                   HorizontalOptions="Center"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
            <Label x:Name="TitleLabel"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"/>
            <Label x:Name="MessageLabel"
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

            <Entry x:Name="PasswordEntry"
                   IsPassword="True"
                   Placeholder="{ext:Localize Password}"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False"
                   ReturnType="Next"
                   Completed="OnPasswordCompleted"/>
            <Entry x:Name="RepeatEntry"
                   IsPassword="True"
                   Placeholder="{ext:Localize RepeatPassword}"
                   IsSpellCheckEnabled="False"
                   IsTextPredictionEnabled="False"
                   ReturnType="Done"
                   Completed="OnOkClicked"/>

            <HorizontalStackLayout Spacing="4">
                <CheckBox x:Name="ShowCheckBox" CheckedChanged="OnShowChanged" VerticalOptions="Center"/>
                <Label Text="{ext:Localize ShowPassword}" FontSize="15" VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnShowLabelTapped"/>
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                <Button Text="{ext:Localize Cancel}"
                        Clicked="OnCancelClicked"
                        MinimumHeightRequest="48"
                        CornerRadius="10"
                        BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#333333}"
                        TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"/>
                <Button Grid.Column="1"
                        Text="{ext:Localize OK}"
                        Clicked="OnOkClicked"
                        MinimumHeightRequest="48"
                        CornerRadius="10"/>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
