<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.ManageCategoriesPage"
             x:DataType="viewmodels:ManageCategoriesViewModel"
             Title="{ext:Localize Categories}">

    <Grid RowDefinitions="Auto,*">
        <!-- Income / Expense switch -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="16,16,16,8">
            <Button Grid.Column="0"
                    Text="{ext:Localize Incomes}"
                    Command="{Binding SelectCategoryTypeCommand}"
                    CommandParameter="{x:Static models:CategoryType.Income}"
                    Style="{StaticResource SegmentButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsExpenseType}" Value="False">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1"
                    Text="{ext:Localize Expenses}"
                    Command="{Binding SelectCategoryTypeCommand}"
                    CommandParameter="{x:Static models:CategoryType.Expense}"
                    Style="{StaticResource SegmentButton}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsExpenseType}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Categories of the shown type; a tap opens the edit sheet -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Categories}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Category">
                    <Border Style="{StaticResource Card}" Margin="16,4" Padding="12">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ManageCategoriesViewModel}}, Path=EditCategoryCommand}"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="Ellipse"
                                    VerticalOptions="Center"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                <Label Text="{Binding DisplayIcon}"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="22"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                            </Border>

                            <Label Grid.Column="1"
                                   Text="{Binding Name}"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation"
                                   VerticalOptions="Center" />

                            <Label Grid.Column="2"
                                   Text="&#xF0142;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="22"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center">
                    <Label Text="&#xF024B;"
                           FontFamily="MaterialDesignIcons"
                           FontSize="48"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    <Label Text="{ext:Localize NoCategoriesYet}"
                           FontSize="16"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.Footer>
                <!-- Room so the last card scrolls above the add button -->
                <ContentView HeightRequest="88" />
            </CollectionView.Footer>
        </CollectionView>

        <Button Grid.RowSpan="2"
                Text="&#xF0415;"
                FontFamily="MaterialDesignIcons"
                FontSize="28"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                Padding="0"
                Margin="0,0,16,16"
                HorizontalOptions="End"
                VerticalOptions="End"
                SemanticProperties.Description="{ext:Localize AddCategoryButton}"
                IsVisible="{Binding IsFormOpen, Converter={StaticResource InvertedBoolConverter}}"
                Command="{Binding AddCategoryCommand}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}"
                Shadow="{Shadow Brush=Black, Offset='0,4', Radius=8, Opacity=0.35}" />

        <!-- Add / edit sheet -->
        <controls:BottomSheet Scroll="{x:Reference FormScroll}"
                              Grid.RowSpan="2"
                              IsOpen="{Binding IsFormOpen}"
                              CloseCommand="{Binding CloseFormCommand}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="12">
                <Label Text="{Binding FormTitle}" FontSize="18" FontAttributes="Bold" />

                <ScrollView Grid.Row="1" x:Name="FormScroll">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{ext:Localize CategoryName}" FontSize="14" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        <Entry Text="{Binding FormName}"
                               Placeholder="{ext:Localize CategoryName}"
                               FontSize="16" />

                        <Label Text="{ext:Localize SelectIcon}" FontSize="14" Margin="0,4,0,0" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                        <FlexLayout Wrap="Wrap"
                                    JustifyContent="Start"
                                    AlignItems="Center"
                                    BindableLayout.ItemsSource="{Binding AvailableIcons}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CategoryIcon">
                                    <Border StrokeThickness="3"
                                            Padding="10"
                                            Margin="4"
                                            WidthRequest="52"
                                            HeightRequest="52"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{Binding IsSelected, Converter={StaticResource BoolToSelectedBackgroundConverter}}">
                                        <Border.Stroke>
                                            <SolidColorBrush Color="{Binding IsSelected, Converter={StaticResource BoolToColorConverter}}" />
                                        </Border.Stroke>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ManageCategoriesViewModel}}, Path=SelectIconCommand}"
                                                                  CommandParameter="{Binding Code}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding DisplayIcon}"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="24"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{Binding IsSelected, Converter={StaticResource BoolToIconColorConverter}}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Delete only for an existing category -->
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                    <Button Text="{ext:Localize DeleteButton}"
                            IsVisible="{Binding IsEditMode}"
                            Command="{Binding DeleteCategoryCommand}"
                            Margin="0,0,12,0"
                            HeightRequest="44"
                            Padding="20,0"
                            CornerRadius="22"
                            BorderWidth="1"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                    <Button Grid.Column="1"
                            Text="{Binding SaveText}"
                            Command="{Binding SaveCategoryCommand}"
                            HeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                </Grid>
            </Grid>
        </controls:BottomSheet>
    </Grid>

</ContentPage>
