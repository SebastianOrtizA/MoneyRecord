<?xml version="1.0" encoding="utf-8" ?>
<!-- More reports: the reports that have no tab of their own, one pushed page each -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.ReportsHubPage"
             x:DataType="viewmodels:ReportsHubViewModel"
             Title="{ext:Localize MoreReports}">

    <ScrollView>
        <VerticalStackLayout Padding="0,8" BindableLayout.ItemsSource="{Binding Reports}">
            <BindableLayout.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:HubReport">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16" Padding="20,14">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ReportsHubViewModel}}, Path=OpenCommand}"
                                                  CommandParameter="{Binding .}"/>
                        </Grid.GestureRecognizers>
                        <Label Text="{Binding Icon}"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Title}" FontSize="16"/>
                            <Label Text="{Binding Hint}" Style="{StaticResource SecondaryLabel}" FontSize="13"/>
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="&#xF0142;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="22"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"/>
                    </Grid>
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
