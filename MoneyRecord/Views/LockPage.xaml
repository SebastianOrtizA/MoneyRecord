<?xml version="1.0" encoding="utf-8" ?>
<!-- The app lock: shown modally over everything until the phone's lock or the app PIN is passed -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:vm="clr-namespace:MoneyRecord.ViewModels;assembly=MoneyRecord.Core"
             x:Class="MoneyRecord.Views.LockPage"
             x:DataType="vm:LockViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout VerticalOptions="Center" Spacing="20" Padding="32">
            <Label Text="&#xF033E;"
                   FontFamily="MaterialDesignIcons"
                   FontSize="64"
                   HorizontalOptions="Center"
                   AutomationProperties.IsInAccessibleTree="False"
                   TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
            <Label Text="{ext:Localize AppLocked}"
                   FontSize="22"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1"
                   HorizontalTextAlignment="Center"/>
            <Label Text="{Binding Subtitle}"
                   FontSize="15"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
            <Label Text="{Binding Message}"
                   MinimumHeightRequest="40"
                   FontSize="14"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#C62828, Dark=#EF9A9A}"/>
            <controls:PinPad IsVisible="{Binding ShowPad}" HorizontalOptions="Center"/>
            <Button Text="{ext:Localize UsePhoneLock}"
                    Command="{Binding UseDeviceLockCommand}"
                    IsVisible="{Binding CanUseDeviceLock}"
                    MinimumHeightRequest="48"
                    CornerRadius="24"
                    HorizontalOptions="Center"
                    Padding="40,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
