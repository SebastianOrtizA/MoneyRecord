<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.PayeesPage"
             x:DataType="viewmodels:PayeesViewModel"
             Title="{ext:Localize Payees}">

    <Grid RowDefinitions="Auto,*">
        <SearchBar Placeholder="{ext:Localize SearchPayees}"
                   Text="{Binding SearchText}"
                   Margin="16,8"
                   FontSize="14"
                   HeightRequest="44"
                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}" />

        <RefreshView Grid.Row="1"
                     IsRefreshing="{Binding IsLoading}"
                     Command="{Binding LoadPayeesCommand}">
            <!-- One row per payee (a tap offers rename / merge / delete), footer = empty state -->
            <!-- The 16px gutter is inside the rows and footer, so the scrollbar sits at the screen edge -->
            <CollectionView ItemsSource="{Binding Payees}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PayeeSummary">
                        <Border Margin="16,4"
                                Padding="14,12"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:PayeesViewModel}}, Path=OpenPayeeCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="Ellipse"
                                        VerticalOptions="Center"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryTint}, Dark={StaticResource PrimaryTintDark}}">
                                    <Label Text="&#xF04DC;"
                                           FontFamily="MaterialDesignIcons"
                                           FontSize="20"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                    <Label Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding UsageText}"
                                           FontSize="12"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Spacing="12"
                                         Padding="32,48"
                                         IsVisible="{Binding IsEmpty}">
                        <Label Text="&#xF04DC;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="64"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Text="{Binding EmptyText}"
                               FontSize="16"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>

</ContentPage>
