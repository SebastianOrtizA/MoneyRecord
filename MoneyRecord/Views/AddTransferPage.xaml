<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:behaviors="clr-namespace:MoneyRecord.Behaviors"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.AddTransferPage"
             Shell.TabBarIsVisible="False"
             x:DataType="viewmodels:AddTransferViewModel"
             Title="{Binding Title}">

    <Shell.BackButtonBehavior>
        <BackButtonBehavior Command="{Binding CancelCommand}"/>
    </Shell.BackButtonBehavior>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="{ext:Localize Date}" FontSize="16" FontAttributes="Bold"/>
            <DatePicker Date="{Binding SelectedDate}" 
                       Format="D"
                       FontSize="16"/>

            <Label Text="{ext:Localize FromAccount}" FontSize="16" FontAttributes="Bold"/>
            <Picker ItemsSource="{Binding Accounts}"
                   SelectedItem="{Binding SelectedSourceAccount}"
                   ItemDisplayBinding="{Binding Name}"
                   Title="{ext:Localize SelectSourceAccount}"
                   FontSize="16"/>
            <Label Text="{Binding SourceAccountBalanceText}" 
                   FontSize="14" 
                   TextColor="{AppThemeBinding Light=#2E7D32, Dark=#66BB6A}"
                   IsVisible="{Binding SourceAccountBalanceText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"/>

            <Label Text="{ext:Localize ToAccount}" FontSize="16" FontAttributes="Bold"/>
            <Picker ItemsSource="{Binding Accounts}"
                   SelectedItem="{Binding SelectedDestinationAccount}"
                   ItemDisplayBinding="{Binding Name}"
                   Title="{ext:Localize SelectDestinationAccount}"
                   FontSize="16"/>

            <Label Text="{ext:Localize Amount}" FontSize="16" FontAttributes="Bold"/>
            <controls:DecimalEntry Text="{Binding Amount}" 
                   Placeholder="0.00"
                   FontSize="16">
                <controls:DecimalEntry.Behaviors>
                    <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding SelectedSourceAccount.CurrencyCode}"/>
                </controls:DecimalEntry.Behaviors>
            </controls:DecimalEntry>

            <!-- Between currencies: what arrived, in the destination account's currency, and the rate it implies -->
            <VerticalStackLayout Spacing="8" IsVisible="{Binding IsCrossCurrency}">
                <Label Text="{ext:Localize AmountReceived}" FontSize="16" FontAttributes="Bold"/>
                <Label Text="{Binding CrossCurrencyHint}" FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
                <controls:DecimalEntry Text="{Binding DestinationAmount}"
                       Placeholder="0.00"
                       FontSize="16">
                    <controls:DecimalEntry.Behaviors>
                        <behaviors:CurrencyMaskBehavior ShowCurrencySymbol="True" CurrencyCode="{Binding SelectedDestinationAccount.CurrencyCode}"/>
                    </controls:DecimalEntry.Behaviors>
                </controls:DecimalEntry>
                <Label Text="{Binding RateText}" FontSize="14"
                       IsVisible="{Binding RateText, Converter={StaticResource IsStringNotNullOrEmptyConverter}}"
                       TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}"/>
            </VerticalStackLayout>

            <Label Text="{ext:Localize TransferDescription}" FontSize="16" FontAttributes="Bold"/>
            <Entry Text="{Binding Description}" 
                   Placeholder="{ext:Localize TransferOptional}"
                   FontSize="16"/>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,20,0,0">
                <Button Grid.Column="0" 
                       Text="{ext:Localize Cancel}" 
                       Command="{Binding CancelCommand}"
                       BackgroundColor="Gray"/>
                <Button Grid.Column="1" 
                       Text="{ext:Localize TransferButton}" 
                       Command="{Binding SaveCommand}"
                       BackgroundColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}"/>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
