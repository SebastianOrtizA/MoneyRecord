<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:helpers="clr-namespace:MoneyRecord.Helpers;assembly=MoneyRecord.Core"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             x:Class="MoneyRecord.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{ext:Localize AppTitle}">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDataCommand}">
            <ScrollView>
                <!-- Bottom padding keeps the last card clear of the add button -->
                <VerticalStackLayout x:Name="CardStack" Padding="16,12,16,88" Spacing="16">
            
            
            <!-- Total Balance Card (Prominent) -->
            <Border x:Name="BalanceCard" BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#7B5FDB}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 16"
                    Padding="20"
                    Shadow="{Shadow Brush=Black, Offset='0,2', Radius=8, Opacity=0.25}">
                <Border.GestureRecognizers>
                    <!-- The card opens all accounts; each currency line below opens that currency's accounts -->
                    <TapGestureRecognizer Command="{Binding OpenAccountsCommand}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" HorizontalOptions="Center">
                        <Label Text="&#xF0070;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="18"
                               TextColor="#FFFFFFCC"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{ext:Localize TotalBalance}"
                               FontSize="15"
                               TextColor="#FFFFFFCC"
                               LineBreakMode="WordWrap"
                               HorizontalTextAlignment="Center"
                               VerticalOptions="Center"/>
                        <!-- Privacy mode: hides the balances and the period totals until tapped again -->
                        <Label Grid.Column="2"
                               Text="&#xF06D0;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="20"
                               MinimumWidthRequest="48"
                               MinimumHeightRequest="48"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               TextColor="#FFFFFFCC"
                               VerticalOptions="Center"
                               SemanticProperties.Description="{ext:Localize HideBalances}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleHideBalancesCommand}"/>
                            </Label.GestureRecognizers>
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding HideBalances}" Value="True">
                                    <Setter Property="Text" Value="&#xF06D1;"/>
                                    <Setter Property="SemanticProperties.Description" Value="{ext:Localize ShowBalances}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Grid>
                    <controls:AutoFitLabel Text="{Binding PrimaryBalance.Text}"
                           MaxFontSize="36"
                           FontAttributes="Bold"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center"
                           TextColor="White">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HideBalances}" Value="True">
                                <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                            </DataTrigger>
                        </Label.Triggers>
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAccountsCommand}" CommandParameter="{Binding PrimaryBalance}"/>
                        </Label.GestureRecognizers>
                    </controls:AutoFitLabel>
                    <!-- One subtotal per other currency: amounts in different currencies are never added together -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OtherBalances}"
                                         IsVisible="{Binding OtherBalances.Count, Converter={StaticResource IntToBoolConverter}}"
                                         Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:BalanceLine">
                                <controls:AutoFitLabel Text="{Binding Text}"
                                       MaxFontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Center"
                                       TextColor="#FFFFFFDD">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=HideBalances}"
                                                     Value="True">
                                            <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=OpenAccountsCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Label.GestureRecognizers>
                                </controls:AutoFitLabel>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding CurrentDate, Converter={StaticResource DateTextConverter}, ConverterParameter=Long}"
                           FontSize="13"
                           TextColor="#FFFFFF99"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout x:Name="PeriodSummaryCard" Spacing="16" IsVisible="{Binding ShowPeriodPicker}">
            <controls:PeriodPicker BindingContext="{Binding Period}" />

            <!-- The period summary: base-currency cards, then the other currencies, in one container so they read as one -->
            <Border Style="{StaticResource PeriodSummary}" IsVisible="{Binding ShowPeriodSummary}">
                <VerticalStackLayout Spacing="8">
                    <!-- "Show in": one total converted into the base currency, or by currency (offered with several currencies
                         and downloaded rates; the reports' "≈" chip is the same choice) -->
                    <HorizontalStackLayout Spacing="8" Padding="2,2,2,0" IsVisible="{Binding CanSwitchShowIn}">
                        <controls:FilterChip Text="{Binding ConvertedChipText}" IsActive="{Binding IsConverted}"
                                             Command="{Binding ShowInCommand}" CommandParameter="True"/>
                        <controls:FilterChip Text="{ext:Localize ShowByCurrency}"
                                             IsActive="{Binding IsConverted, Converter={StaticResource InvertedBoolConverter}}"
                                             Command="{Binding ShowInCommand}" CommandParameter="False"/>
                    </HorizontalStackLayout>

                    <!-- Income / Expense / Net Row -->
                    <Grid x:Name="PeriodTiles" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <!-- Incomes Card -->
                        <Border Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="&#xF0415;"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#1976D2, Dark=#90CAF9}"/>
                                <!-- "≈ Incomes" while converted: the mark goes on the caption so the amount keeps its line -->
                                <Label FontSize="11"
                                       TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}"
                                       HorizontalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding BaseTotals.ApproximateMark}"/>
                                            <Span Text="{ext:Localize Incomes}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <controls:AutoFitLabel Text="{Binding BaseTotals.IncomeText}"
                                       MaxFontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#1976D2, Dark=#E3F2FD}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HideBalances}" Value="True">
                                            <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </controls:AutoFitLabel>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Expenses Card -->
                        <Border Grid.Column="1"
                                BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="&#xF0374;"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#D32F2F, Dark=#FFCDD2}"/>
                                <Label FontSize="11"
                                       TextColor="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"
                                       HorizontalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding BaseTotals.ApproximateMark}"/>
                                            <Span Text="{ext:Localize Expenses}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <controls:AutoFitLabel Text="{Binding BaseTotals.ExpenseText}"
                                       MaxFontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#D32F2F, Dark=#FFEBEE}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HideBalances}" Value="True">
                                            <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </controls:AutoFitLabel>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Net Card: green, or the expense palette when net is negative -->
                        <Border Grid.Column="2"
                                BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="10">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding BaseTotals.IsNetNegative}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}"/>
                                </DataTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="4">
                                <Label Text="&#xF04E1;"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="20"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding BaseTotals.IsNetNegative}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label FontSize="11"
                                       TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"
                                       HorizontalOptions="Center">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding BaseTotals.ApproximateMark}"/>
                                            <Span Text="{ext:Localize NetIncome}"/>
                                        </FormattedString>
                                    </Label.FormattedText>
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding BaseTotals.IsNetNegative}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <controls:AutoFitLabel Text="{Binding BaseTotals.NetText}"
                                       MaxFontSize="16"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Fill"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#1B5E20, Dark=#E8F5E9}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding HideBalances}" Value="True">
                                            <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding BaseTotals.IsNetNegative}" Value="True">
                                            <Setter Property="TextColor" Value="{AppThemeBinding Light=#D32F2F, Dark=#FFCDD2}"/>
                                        </DataTrigger>
                                    </Label.Triggers>
                                </controls:AutoFitLabel>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- While converted, the pills hold what had no rate yet -->
                    <Label Text="{ext:Localize NoRateYet}" IsVisible="{Binding ShowNoRateCaption}" FontSize="12"
                           Margin="4,0" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                    <!-- The same totals in other currencies, one row each, a pill under the matching card (never added together;
                         hidden with the balances) -->
                    <VerticalStackLayout Spacing="6" IsVisible="{Binding ShowOtherTotals}"
                                         BindableLayout.ItemsSource="{Binding OtherTotals}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:PeriodTotals">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                    <Border Style="{StaticResource OtherCurrencyPill}"
                                            BackgroundColor="{AppThemeBinding Light=#EEF6FE, Dark=#122B4A}">
                                        <controls:AutoFitLabel Text="{Binding IncomeText}" Style="{StaticResource OtherCurrencyTotal}"
                                               TextColor="{AppThemeBinding Light=#1976D2, Dark=#90CAF9}"/>
                                    </Border>
                                    <Border Grid.Column="1" Style="{StaticResource OtherCurrencyPill}"
                                            BackgroundColor="{AppThemeBinding Light=#FFF2F4, Dark=#3F1619}">
                                        <controls:AutoFitLabel Text="{Binding ExpenseText}" Style="{StaticResource OtherCurrencyTotal}"
                                               TextColor="{AppThemeBinding Light=#D32F2F, Dark=#EF9A9A}"/>
                                    </Border>
                                    <!-- Green, or the expense palette when this currency's net is negative (like the Net card) -->
                                    <Border Grid.Column="2" Style="{StaticResource OtherCurrencyPill}"
                                            BackgroundColor="{AppThemeBinding Light=#EFF8F0, Dark=#14321B}">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsNetNegative}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFF2F4, Dark=#3F1619}"/>
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <controls:AutoFitLabel Text="{Binding NetText}" Style="{StaticResource OtherCurrencyTotal}"
                                               TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsNetNegative}" Value="True">
                                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#D32F2F, Dark=#EF9A9A}"/>
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </controls:AutoFitLabel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{Binding ConvertedNote}" IsVisible="{Binding ShowConvertedNote}" FontSize="12"
                           Margin="4,0,4,2" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                </VerticalStackLayout>
            </Border>
            </VerticalStackLayout>

            <!-- First-run checklist: until it is hidden or done -->
            <Border Style="{StaticResource Card}" x:Name="StartChecklistCard" IsVisible="{Binding ShowStartChecklist}">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Localize GetStartedTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{ext:Localize GetStartedHide}"
                               Style="{StaticResource CardLink}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding HideStartChecklistCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding StartChecklist.Rows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:GetStartedRow">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="4,10">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=OpenStartStepCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Grid.GestureRecognizers>
                                    <Label Text="{Binding DoneIcon}"
                                           FontFamily="MaterialDesignIcons"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           AutomationProperties.IsInAccessibleTree="False"
                                           TextColor="{AppThemeBinding Light=#512BD4, Dark=#B39DFF}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Done}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#2E7D32, Dark=#81C784}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontSize="15"
                                           VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Done}" Value="True">
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Recent Transactions Quick View -->
            <Border Style="{StaticResource Card}"
                    x:Name="RecentCard" IsVisible="{Binding ShowRecent}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Localize RecentTransactions}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{ext:Localize SeeAll}"
                               Style="{StaticResource CardLink}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeeAllTransactionsCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentTransactions}" Spacing="6" IsVisible="{Binding HasRecentTransactions}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:LedgerEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,6">
                                    <Label Grid.Column="0"
                                           Text="{Binding CategoryDisplayIcon}"
                                           FontFamily="MaterialDesignIcons"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Date, Converter={StaticResource DateTextConverter}, ConverterParameter=MonthDay}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding ., Converter={StaticResource TransactionAmountConverter}}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           HorizontalTextAlignment="End"
                                           TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=HideBalances}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <!-- An empty period: say how to add the first entry -->
                    <controls:EmptyState IsVisible="{Binding ShowRecentEmpty}"
                                         Icon="&#xF0279;"
                                         Title="{ext:Localize NoTransactionsInPeriod}"
                                         Message="{ext:Localize AddEntryHint}" />
                </VerticalStackLayout>
            </Border>

            <!-- Upcoming: the next scheduled recurring transactions -->
            <Border Style="{StaticResource Card}"
                    x:Name="UpcomingCard" IsVisible="{Binding ShowUpcoming}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Localize Upcoming}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{ext:Localize SeeAll}"
                               Style="{StaticResource CardLink}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeeAllUpcomingCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingEntries}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:UpcomingEntry">
                                <controls:UpcomingRow>
                                    <controls:UpcomingRow.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=EnterOccurrenceCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </controls:UpcomingRow.GestureRecognizers>
                                </controls:UpcomingRow>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Budget Summary Section -->
            <Border Style="{StaticResource Card}" x:Name="BudgetsCard" IsVisible="{Binding ShowBudgets}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Localize BudgetSummary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Border BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    Padding="8,4">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="{Binding BudgetsOnTrack}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"/>
                                    <Label Text="{ext:Localize OnTrack}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"/>
                                </HorizontalStackLayout>
                            </Border>
                            <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    Padding="8,4"
                                    IsVisible="{Binding BudgetsOverBudget, Converter={StaticResource IntToBoolConverter}}">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="{Binding BudgetsOverBudget}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"/>
                                    <Label Text="{ext:Localize OverBudget}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding BudgetSummaries}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:BudgetProgress">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                           Text="{Binding DisplayIcon}"
                                           FontFamily="MaterialDesignIcons"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding CategoryName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                    <!-- Spent of the limit, so the bar colour has context -->
                                    <Label Grid.Row="0" Grid.Column="2" FontSize="14">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding SpentAmount, Converter={StaticResource MoneyConverter}}"
                                                      FontAttributes="Bold"/>
                                                <Span Text=" / "
                                                      TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                                <Span Text="{Binding LimitAmount, Converter={StaticResource MoneyConverter}}"
                                                      TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                                 ProgressColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}"
                                                 HeightRequest="4"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{ext:Localize SeeAll}"
                           Style="{StaticResource CardLink}"
                           HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewAllBudgetsCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- The active trip: spent of its budget; a tap opens it -->
            <Border Style="{StaticResource Card}" x:Name="ActiveTripCard" IsVisible="{Binding ShowTrip}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenTripCommand}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Label Text="&#xF001D;" FontFamily="MaterialDesignIcons" FontSize="20" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                        <Label Grid.Column="1" Text="{Binding ActiveTrip.Name}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                        <Label Grid.Column="2" Text="{Binding ActiveTrip.DatesText}" FontSize="12" VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                    </Grid>
                    <ProgressBar IsVisible="{Binding ActiveTrip.HasBudget}"
                                 Progress="{Binding ActiveTrip.ProgressPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                 ProgressColor="{Binding ActiveTrip.Level, Converter={StaticResource BudgetLevelToColorConverter}}"
                                 BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                 HeightRequest="10"/>
                    <Label Text="{Binding ActiveTrip.SpentText}" FontSize="14">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding HideBalances}" Value="True">
                                <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
            </Border>

            <!-- Savings goals: the first three (today's balances, so the period doesn't apply); a tap opens Goals -->
            <Border Style="{StaticResource Card}"
                    x:Name="GoalsCard" IsVisible="{Binding ShowGoals}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ViewAllGoalsCommand}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Localize SavingsGoalsTitle}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{ext:Localize SeeAll}"
                               Style="{StaticResource CardLink}"/>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding GoalSummaries}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:GoalProgress">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                           Text="{Binding DisplayIcon}"
                                           FontFamily="MaterialDesignIcons"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"/>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                    <!-- Saved of the target; hidden with the balances (the bar still shows the share) -->
                                    <Label Grid.Row="0" Grid.Column="2"
                                           Text="{Binding SavedOfTargetText}"
                                           FontSize="14">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label"
                                                         Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=HideBalances}"
                                                         Value="True">
                                                <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                                 ProgressColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}"
                                                 HeightRequest="4"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Open debts: totals per currency and the first three; a tap opens Debts (off by default) -->
            <Border Style="{StaticResource Card}" x:Name="DebtsCard" IsVisible="{Binding ShowDebts}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenDebtsCommand}"/>
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="10">
                    <Label Text="{ext:Localize Debts}" FontSize="18" FontAttributes="Bold"/>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{ext:Localize DebtsOwedToYou}" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <controls:AutoFitLabel Text="{Binding DebtsOwedToYouText}" MaxFontSize="16" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource IncomeColor}, Dark={StaticResource IncomeColorDark}}">
                                <controls:AutoFitLabel.Triggers>
                                    <DataTrigger TargetType="controls:AutoFitLabel" Binding="{Binding HideBalances}" Value="True">
                                        <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                    </DataTrigger>
                                </controls:AutoFitLabel.Triggers>
                            </controls:AutoFitLabel>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{ext:Localize DebtsYouOwe}" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <controls:AutoFitLabel Text="{Binding DebtsYouOweText}" MaxFontSize="16" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}">
                                <controls:AutoFitLabel.Triggers>
                                    <DataTrigger TargetType="controls:AutoFitLabel" Binding="{Binding HideBalances}" Value="True">
                                        <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                    </DataTrigger>
                                </controls:AutoFitLabel.Triggers>
                            </controls:AutoFitLabel>
                        </VerticalStackLayout>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DebtSummaries}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:DebtSummary">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Title}" FontSize="15" LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding DetailText}" FontSize="12" TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1" Text="{Binding OutstandingText}" FontSize="15" FontAttributes="Bold" VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=HideBalances}" Value="True">
                                                <Setter Property="Text" Value="{StaticResource HiddenAmount}"/>
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="{ext:Localize CustomizeHome}" Style="{StaticResource CardLink}" HorizontalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CustomizeHomeCommand}"/>
                </Label.GestureRecognizers>
            </Label>

                        </VerticalStackLayout>
                    </ScrollView>
                </RefreshView>

                <!-- Loading Indicator Overlay -->
                <Grid IsVisible="{Binding IsRefreshing}"
                      BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
                    <ActivityIndicator IsRunning="{Binding IsRefreshing}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Color="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}"
                                       HeightRequest="50"
                                       WidthRequest="50"/>
                </Grid>

                <controls:AddEntryButton x:Name="AddEntry" />
            </Grid>

        </ContentPage>
