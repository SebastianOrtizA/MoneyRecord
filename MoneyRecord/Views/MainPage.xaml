<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:helpers="clr-namespace:MoneyRecord.Helpers;assembly=MoneyRecord.Core"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             x:Class="MoneyRecord.Views.MainPage"
             x:DataType="viewmodels:MainViewModel"
             Title="{ext:Localize AppTitle}">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDataCommand}">
            <ScrollView>
                <!-- Bottom padding keeps the last card clear of the add button -->
                <VerticalStackLayout Padding="16,12,16,88" Spacing="16">
            
            
            <!-- Total Balance Card (Prominent) -->
            <Frame BackgroundColor="{AppThemeBinding Light=#512BD4, Dark=#7B5FDB}"
                   BorderColor="Transparent"
                   CornerRadius="16"
                   Padding="20"
                   HasShadow="True">
                <Frame.GestureRecognizers>
                    <!-- The card opens all accounts; each currency line below opens that currency's accounts -->
                    <TapGestureRecognizer Command="{Binding OpenAccountsCommand}"/>
                </Frame.GestureRecognizers>
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="&#xF0070;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="18"
                               TextColor="#FFFFFFCC"
                               VerticalOptions="Center"/>
                        <Label Text="{ext:Localize TotalBalance}"
                               FontSize="15"
                               TextColor="#FFFFFFCC"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    <Label Text="{Binding PrimaryBalance.Text}"
                           FontSize="36"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center"
                           TextColor="White">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAccountsCommand}" CommandParameter="{Binding PrimaryBalance}"/>
                        </Label.GestureRecognizers>
                    </Label>
                    <!-- One subtotal per other currency: amounts in different currencies are never added together -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding OtherBalances}"
                                         IsVisible="{Binding OtherBalances.Count, Converter={StaticResource IntToBoolConverter}}"
                                         Spacing="2">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:BalanceLine">
                                <Label Text="{Binding Text}"
                                       FontSize="20"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"
                                       TextColor="#FFFFFFDD">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainViewModel}}, Path=OpenAccountsCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Label.GestureRecognizers>
                                </Label>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <Label Text="{Binding CurrentDate, Converter={StaticResource DateTextConverter}, ConverterParameter=Long}"
                           FontSize="13"
                           TextColor="#FFFFFF99"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Frame>

            <controls:PeriodPicker BindingContext="{Binding Period}" />

            <!-- Income / Expense / Net Row -->
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                <!-- Incomes Card -->
                <Frame Grid.Column="0"
                       BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}"
                       BorderColor="Transparent"
                       CornerRadius="12"
                       Padding="10"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xF0415;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="20"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#1976D2, Dark=#90CAF9}"/>
                        <Label Text="{ext:Localize Incomes}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalIncomes, Converter={StaticResource MoneyConverter}}"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#1976D2, Dark=#E3F2FD}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Expenses Card -->
                <Frame Grid.Column="1"
                       BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}"
                       BorderColor="Transparent"
                       CornerRadius="12"
                       Padding="10"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xF0374;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="20"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#D32F2F, Dark=#FFCDD2}"/>
                        <Label Text="{ext:Localize Expenses}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding TotalExpenses, Converter={StaticResource MoneyConverter}}"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#D32F2F, Dark=#FFEBEE}"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Net Card: green, or the expense palette when net is negative -->
                <Frame Grid.Column="2"
                       BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                       BorderColor="Transparent"
                       CornerRadius="12"
                       Padding="10"
                       HasShadow="False">
                    <Frame.Triggers>
                        <DataTrigger TargetType="Frame" Binding="{Binding IsNetNegative}" Value="True">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}"/>
                        </DataTrigger>
                    </Frame.Triggers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="&#xF04E1;"
                               FontFamily="MaterialDesignIcons"
                               FontSize="20"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsNetNegative}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{ext:Localize NetIncome}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"
                               HorizontalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsNetNegative}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="{Binding NetIncome, Converter={StaticResource SignedMoneyConverter}}"
                               FontSize="16"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#1B5E20, Dark=#E8F5E9}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsNetNegative}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light=#D32F2F, Dark=#FFCDD2}"/>
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Recent Transactions Quick View -->
            <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True"
                   IsVisible="{Binding HasRecentTransactions}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Localize RecentTransactions}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{ext:Localize SeeAll}"
                               Style="{StaticResource CardLink}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeeAllTransactionsCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentTransactions}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:LedgerEntry">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Padding="4,6">
                                    <Label Grid.Column="0"
                                           Text="{Binding CategoryDisplayIcon}"
                                           FontFamily="MaterialDesignIcons"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Description}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation"/>
                                        <Label Text="{Binding Date, Converter={StaticResource DateTextConverter}, ConverterParameter=MonthDay}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                    </VerticalStackLayout>
                                    <Label Grid.Column="2"
                                           Text="{Binding ., Converter={StaticResource TransactionAmountConverter}}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Upcoming: the next scheduled recurring transactions -->
            <!-- A Border with the look of the Frames around it (Frame is obsolete; 11.5 converts the rest) -->
            <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                    Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                    StrokeShape="RoundRectangle 12"
                    Padding="16"
                    IsVisible="{Binding HasUpcoming}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Localize Upcoming}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <Label Grid.Column="1"
                               Text="{ext:Localize SeeAll}"
                               Style="{StaticResource CardLink}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SeeAllUpcomingCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding UpcomingEntries}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:UpcomingEntry">
                                <controls:UpcomingRow/>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Budget Summary Section -->
            <Frame IsVisible="{Binding HasBudgets}"
                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#3A3A3A}"
                   CornerRadius="12"
                   Padding="16"
                   HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{ext:Localize BudgetSummary}"
                               FontSize="18"
                               FontAttributes="Bold"
                               VerticalOptions="Center"/>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                            <Border BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1B5E20}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    Padding="8,4">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="{Binding BudgetsOnTrack}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"/>
                                    <Label Text="{ext:Localize OnTrack}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#2E7D32, Dark=#A5D6A7}"/>
                                </HorizontalStackLayout>
                            </Border>
                            <Border BackgroundColor="{AppThemeBinding Light=#FFEBEE, Dark=#B71C1C}"
                                    StrokeShape="RoundRectangle 10"
                                    Stroke="Transparent"
                                    Padding="8,4"
                                    IsVisible="{Binding BudgetsOverBudget, Converter={StaticResource IntToBoolConverter}}">
                                <HorizontalStackLayout Spacing="3">
                                    <Label Text="{Binding BudgetsOverBudget}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"/>
                                    <Label Text="{ext:Localize OverBudget}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#C62828, Dark=#FFCDD2}"/>
                                </HorizontalStackLayout>
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding BudgetSummaries}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:BudgetProgress">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" RowDefinitions="Auto,Auto" RowSpacing="2">
                                    <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                           Text="{Binding DisplayIcon}"
                                           FontFamily="MaterialDesignIcons"
                                           FontSize="22"
                                           VerticalOptions="Center"
                                           TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding CategoryName}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>
                                    <!-- Spent of the limit, so the bar colour has context -->
                                    <Label Grid.Row="0" Grid.Column="2" FontSize="14">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding SpentAmount, Converter={StaticResource MoneyConverter}}"
                                                      FontAttributes="Bold"/>
                                                <Span Text=" / "
                                                      TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                                <Span Text="{Binding LimitAmount, Converter={StaticResource MoneyConverter}}"
                                                      TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Progress="{Binding ProgressPercentage, Converter={StaticResource PercentageToProgressConverter}}"
                                                 ProgressColor="{Binding Level, Converter={StaticResource BudgetLevelToColorConverter}}"
                                                 HeightRequest="4"/>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label Text="{ext:Localize SeeAll}"
                           Style="{StaticResource CardLink}"
                           HorizontalOptions="End">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewAllBudgetsCommand}"/>
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </Frame>

                        </VerticalStackLayout>
                    </ScrollView>
                </RefreshView>

                <!-- Loading Indicator Overlay -->
                <Grid IsVisible="{Binding IsRefreshing}"
                      BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
                    <ActivityIndicator IsRunning="{Binding IsRefreshing}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Color="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}"
                                       HeightRequest="50"
                                       WidthRequest="50"/>
                </Grid>

                <controls:AddEntryButton x:Name="AddEntry" />
            </Grid>

        </ContentPage>
