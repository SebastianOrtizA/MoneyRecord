<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels;assembly=MoneyRecord.Core"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             x:Class="MoneyRecord.Views.SupportPage"
             x:DataType="viewmodels:SupportViewModel"
             Title="{ext:Localize SupportTitle}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="&#xF02D1;"
                           FontFamily="MaterialDesignIcons"
                           FontSize="40"
                           HorizontalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                    <Label Text="{ext:Localize SupportIntro}" FontSize="15" />

                    <!-- Tips through the store -->
                    <VerticalStackLayout Spacing="8" IsVisible="{Binding HasTips}">
                        <Label Text="{ext:Localize SupportTipsHeading}" FontSize="16" FontAttributes="Bold" Margin="0,8,0,0" />
                        <FlexLayout Wrap="Wrap" Direction="Row" JustifyContent="Start"
                                    BindableLayout.ItemsSource="{Binding Tips}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TipOption">
                                    <Button Text="{Binding Price}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:SupportViewModel}}, Path=TipCommand, x:DataType=viewmodels:SupportViewModel}"
                                            CommandParameter="{Binding .}"
                                            Margin="0,0,8,8"
                                            HeightRequest="44"
                                            MinimumWidthRequest="96"
                                            Padding="20,0"
                                            CornerRadius="22"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                                            TextColor="White" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                    <Label Text="{ext:Localize TipsUnavailable}" FontSize="14"
                           IsVisible="{Binding ShowTipsUnavailable}"
                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />

                    <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
