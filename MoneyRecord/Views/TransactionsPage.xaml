<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:helpers="clr-namespace:MoneyRecord.Helpers;assembly=MoneyRecord.Core"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             x:Class="MoneyRecord.Views.TransactionsPage"
             x:DataType="viewmodels:TransactionsViewModel"
             Title="{ext:Localize Transactions}">

    <ContentPage.Resources>
        <!-- One row: tap opens the detail sheet, swipe left reveals Edit and Delete -->
        <DataTemplate x:Key="EntryTemplate" x:DataType="models:LedgerEntry">
            <SwipeView Margin="0,4">
                <SwipeView.RightItems>
                    <!-- The first item sits at the edge; SwipeItemView so the labels can be white -->
                    <SwipeItems Mode="Reveal">
                        <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                       CommandParameter="{Binding .}">
                            <Grid WidthRequest="80"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="&#xF01B4;" FontFamily="MaterialDesignIcons" FontSize="22" TextColor="White"
                                           HorizontalOptions="Center" />
                                    <Label Text="{ext:Localize DeleteButton}" FontSize="12" TextColor="White" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </SwipeItemView>
                        <SwipeItemView Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=EditTransactionCommand}"
                                       CommandParameter="{Binding .}">
                            <Grid WidthRequest="80"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource IncomeColor}, Dark={StaticResource IncomeColorDark}}">
                                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                    <Label Text="&#xF03EB;" FontFamily="MaterialDesignIcons" FontSize="22" TextColor="White"
                                           HorizontalOptions="Center" />
                                    <Label Text="{ext:Localize EditButton}" FontSize="12" TextColor="White" HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Grid>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.RightItems>

                <Border Padding="12"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=ShowDetailsCommand}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border WidthRequest="40" HeightRequest="40" StrokeThickness="0" StrokeShape="Ellipse"
                                VerticalOptions="Center"
                                BackgroundColor="{AppThemeBinding Light=#F0EDFA, Dark=#2D2840}">
                            <Label Text="{Binding CategoryDisplayIcon}"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="20"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Description}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation" />
                            <Label FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="{Binding CategoryName}" />
                                        <Span Text=" · " />
                                        <Span Text="{Binding AccountDisplayName}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding ., Converter={StaticResource TransactionAmountConverter}}"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   HorizontalOptions="End"
                                   TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}" />
                            <HorizontalStackLayout Spacing="4" HorizontalOptions="End">
                                <Label Text="&#xF04F9;"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding HasTags}"
                                       SemanticProperties.Description="{ext:Localize Tags}"
                                       TextColor="{AppThemeBinding Light={StaticResource TransferColor}, Dark={StaticResource TransferColorDark}}" />
                                <Label Text="&#xF0449;"
                                       FontFamily="MaterialDesignIcons"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       IsVisible="{Binding HasReceipt}"
                                       SemanticProperties.Description="{ext:Localize ReceiptAttached}"
                                       TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}" />
                                <Label Text="{Binding Date, Converter={StaticResource DateTextConverter}, ConverterParameter=Medium}"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </SwipeView>
        </DataTemplate>

        <!-- A group header (tap expands it) with its rows -->
        <DataTemplate x:Key="GroupTemplate" x:DataType="models:TransactionGroup">
            <VerticalStackLayout Margin="0,4">
                <Border Padding="14,12"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F0EDFA, Dark=#2D2840}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=ToggleGroupExpandedCommand}"
                                              CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="2">
                        <Label Grid.RowSpan="2"
                               Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                               FontFamily="MaterialDesignIcons"
                               FontSize="16"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Grid.Column="1" Grid.RowSpan="2"
                               Text="{Binding GroupDisplayIcon}"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Label Grid.Column="2"
                               Text="{Binding GroupName}"
                               FontSize="16"
                               FontAttributes="Bold"
                               LineBreakMode="TailTruncation" />
                        <Label Grid.Column="3"
                               Text="{Binding ., Converter={StaticResource GroupTotalConverter}}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{Binding ., Converter={StaticResource GroupTypeToColorConverter}}" />
                        <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                               Text="{Binding TransactionCount, Converter={StaticResource TransactionCountConverter}}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                     BindableLayout.ItemsSource="{Binding Items}"
                                     BindableLayout.ItemTemplate="{StaticResource EntryTemplate}"
                                     Margin="12,0,0,0" />
            </VerticalStackLayout>
        </DataTemplate>

        <controls:LedgerItemTemplateSelector x:Key="LedgerItemTemplateSelector"
                                             EntryTemplate="{StaticResource EntryTemplate}"
                                             GroupTemplate="{StaticResource GroupTemplate}" />
    </ContentPage.Resources>

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDataCommand}">
            <CollectionView ItemsSource="{Binding Items}"
                            ItemTemplate="{StaticResource LedgerItemTemplateSelector}"
                            Margin="16,0">
                <CollectionView.Header>
                    <VerticalStackLayout Padding="0,12,0,4" Spacing="12">
                        <Picker ItemsSource="{Binding Periods}"
                                SelectedItem="{Binding SelectedPeriod}"
                                Title="{ext:Localize SelectPeriod}"
                                FontSize="16"
                                MinimumHeightRequest="44"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}" />

                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12"
                              IsVisible="{Binding IsCustomPeriodSelected}">
                            <Label Text="{ext:Localize From}" FontSize="16" VerticalOptions="Center" />
                            <DatePicker Grid.Column="1"
                                        Date="{Binding CustomStartDate}"
                                        Format="{x:Static helpers:DateFormatter.MediumPattern}"
                                        FontSize="16"
                                        MinimumHeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}" />
                            <Label Grid.Row="1" Text="{ext:Localize To}" FontSize="16" VerticalOptions="Center" />
                            <DatePicker Grid.Row="1" Grid.Column="1"
                                        Date="{Binding CustomEndDate}"
                                        Format="{x:Static helpers:DateFormatter.MediumPattern}"
                                        FontSize="16"
                                        MinimumHeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}" />
                        </Grid>

                        <SearchBar Placeholder="{ext:Localize SearchTransactions}"
                                   Text="{Binding Filters.SearchText}"
                                   SearchCommand="{Binding Filters.SearchCommand}"
                                   FontSize="14"
                                   HeightRequest="44"
                                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}" />

                        <!-- Filter chips: the name until it filters, then the chosen value -->
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8">
                                <controls:FilterChip Text="{Binding Filters.TypeChipText}" IsActive="{Binding Filters.IsTypeActive}"
                                                     Command="{Binding Filters.PickTypeCommand}" />
                                <controls:FilterChip Text="{Binding Filters.CategoryChipText}" IsActive="{Binding Filters.IsCategoryActive}"
                                                     Command="{Binding Filters.PickCategoryCommand}" />
                                <controls:FilterChip Text="{Binding Filters.AccountChipText}" IsActive="{Binding Filters.IsAccountActive}"
                                                     Command="{Binding Filters.PickAccountCommand}" />
                                <controls:FilterChip Text="{Binding Filters.AmountChipText}" IsActive="{Binding Filters.IsAmountActive}"
                                                     Command="{Binding Filters.ToggleAmountCommand}" />
                                <controls:FilterChip Text="{Binding Filters.TagChipText}" IsActive="{Binding Filters.IsTagActive}"
                                                     Command="{Binding Filters.PickTagCommand}" />
                            </HorizontalStackLayout>
                        </ScrollView>

                        <!-- The Amount chip opens the range; the limits apply to every currency -->
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8" IsVisible="{Binding Filters.IsAmountVisible}">
                            <controls:DecimalEntry Text="{Binding Filters.MinAmountText}"
                                                   Placeholder="{ext:Localize Min}"
                                                   FontSize="14"
                                                   HeightRequest="44"
                                                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}" />
                            <Label Grid.Column="1" Text="—" VerticalOptions="Center" />
                            <controls:DecimalEntry Grid.Column="2"
                                                   Text="{Binding Filters.MaxAmountText}"
                                                   Placeholder="{ext:Localize Max}"
                                                   FontSize="14"
                                                   HeightRequest="44"
                                                   BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}" />
                        </Grid>

                        <!-- Count and Clear while filtered; grouping and sort -->
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="4">
                            <Label Text="{Binding FilteredCountText}"
                                   IsVisible="{Binding HasActiveFilters}"
                                   FontSize="13"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            <Label Grid.Column="1"
                                   Text="{ext:Localize ClearFilters}"
                                   IsVisible="{Binding HasActiveFilters}"
                                   Style="{StaticResource CardLink}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Filters.ClearCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Grid.Column="3"
                                   Text="{Binding CurrentGroupingMode, Converter={StaticResource BoolToGroupTextConverter}}"
                                   Style="{StaticResource CardLink}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleGroupingCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Label Grid.Column="4"
                                   Text="{Binding IsAscending, Converter={StaticResource BoolToSortTextConverter}}"
                                   Style="{StaticResource CardLink}">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleSortOrderCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </CollectionView.Header>

                <!-- The empty state lives in the footer so the header stays; the padding keeps the last row clear of the add button -->
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,0,0,88">
                        <VerticalStackLayout Padding="24,40" Spacing="12" IsVisible="{Binding IsEmpty}">
                            <Label Text="&#xF0279;"
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="48"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasActiveFilters}" Value="True">
                                        <Setter Property="Text" Value="&#xF0234;" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Text="{Binding EmptyTitle}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding EmptyHint}"
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                            <Button Text="{ext:Localize ClearFilters}"
                                    IsVisible="{Binding HasActiveFilters}"
                                    Command="{Binding Filters.ClearCommand}"
                                    HorizontalOptions="Center"
                                    Padding="20,0"
                                    HeightRequest="40"
                                    CornerRadius="20" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <!-- Loading Indicator Overlay -->
        <Grid IsVisible="{Binding IsRefreshing}"
              BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
            <ActivityIndicator IsRunning="{Binding IsRefreshing}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Color="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}"
                               HeightRequest="50"
                               WidthRequest="50" />
        </Grid>

        <controls:AddEntryButton x:Name="AddEntry" />

        <!-- Detail sheet: dimmed page behind it; tapping the dim closes it -->
        <BoxView BackgroundColor="#80000000" IsVisible="{Binding IsDetailsOpen}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseDetailsCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border x:Name="DetailsSheet"
                IsVisible="{Binding IsDetailsOpen}"
                VerticalOptions="End"
                Padding="20,12,20,24"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20,20,0,0"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
            <VerticalStackLayout Spacing="12">
                <Border WidthRequest="36"
                        HeightRequest="4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 2"
                        HorizontalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light=#BDBDBD, Dark=#616161}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                    <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="Ellipse"
                            VerticalOptions="Center"
                            BackgroundColor="{AppThemeBinding Light=#F0EDFA, Dark=#2D2840}">
                        <Label Text="{Binding SelectedEntry.CategoryDisplayIcon}"
                               FontFamily="MaterialDesignIcons"
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{Binding SelectedEntry.Type, Converter={StaticResource TransactionTypeToColorConverter}}" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="{Binding SelectedEntry.Description}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding SelectedEntry.CategoryName}"
                               FontSize="14"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}" />
                    </VerticalStackLayout>
                </Grid>

                <Label Text="{Binding SelectedEntry, Converter={StaticResource TransactionAmountConverter}}"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{Binding SelectedEntry.Type, Converter={StaticResource TransactionTypeToColorConverter}}" />

                <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                    <Label Text="&#xF00ED;" FontFamily="MaterialDesignIcons" FontSize="18" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
                    <Label Grid.Column="1"
                           Text="{Binding SelectedEntry.Date, Converter={StaticResource DateTextConverter}, ConverterParameter=Long}"
                           FontSize="15" VerticalOptions="Center" />

                    <Label Grid.Row="1" Text="{Binding SelectedEntry.AccountDisplayIcon}" FontFamily="MaterialDesignIcons"
                           FontSize="18" VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedEntry.AccountDisplayName}"
                           FontSize="15" VerticalOptions="Center" />

                    <Label Grid.Row="2" Text="&#xF04F9;" FontFamily="MaterialDesignIcons" FontSize="18" VerticalOptions="Center"
                           IsVisible="{Binding SelectedEntry.HasTags}"
                           TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}" />
                    <Label Grid.Row="2" Grid.Column="1" Text="{Binding SelectedEntry.Tags}"
                           IsVisible="{Binding SelectedEntry.HasTags}"
                           FontSize="15" VerticalOptions="Center" />
                </Grid>

                <!-- Receipt preview: tap for the full photo -->
                <Border IsVisible="{Binding SelectedEntry.HasReceipt}"
                        HeightRequest="160"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"
                        SemanticProperties.Description="{ext:Localize ViewReceipt}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenReceiptCommand}" />
                    </Border.GestureRecognizers>
                    <Image Source="{Binding SelectedEntry.ReceiptPhotoPath}" Aspect="AspectFill" />
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Button Text="{ext:Localize EditButton}"
                            Command="{Binding EditSelectedCommand}"
                            HeightRequest="44"
                            CornerRadius="22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    <Button Grid.Column="1"
                            Text="{ext:Localize DeleteButton}"
                            Command="{Binding DeleteSelectedCommand}"
                            HeightRequest="44"
                            CornerRadius="22"
                            BorderWidth="1"
                            BackgroundColor="Transparent"
                            BorderColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}"
                            TextColor="{AppThemeBinding Light={StaticResource ExpenseColor}, Dark={StaticResource ExpenseColorDark}}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- The receipt full screen; tap anywhere to close -->
        <Grid IsVisible="{Binding IsReceiptOpen}" BackgroundColor="Black">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseReceiptCommand}" />
            </Grid.GestureRecognizers>
            <Image Source="{Binding SelectedEntry.ReceiptPhotoPath}" Aspect="AspectFit" />
        </Grid>
    </Grid>

</ContentPage>
