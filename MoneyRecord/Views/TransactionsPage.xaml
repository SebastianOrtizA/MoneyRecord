<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:MoneyRecord.ViewModels"
             xmlns:models="clr-namespace:MoneyRecord.Models;assembly=MoneyRecord.Core"
             xmlns:ext="clr-namespace:MoneyRecord.Extensions"
             xmlns:helpers="clr-namespace:MoneyRecord.Helpers;assembly=MoneyRecord.Core"
             xmlns:controls="clr-namespace:MoneyRecord.Controls"
             x:Class="MoneyRecord.Views.TransactionsPage"
             x:DataType="viewmodels:TransactionsViewModel"
             Title="{ext:Localize Transactions}">

    <Grid>
        <RefreshView IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadDataCommand}">
            <ScrollView>
                <!-- Bottom padding keeps the last row clear of the add button -->
                <VerticalStackLayout Padding="16,12,16,88" Spacing="16">

            <!-- Period Selector -->
            <Picker ItemsSource="{Binding Periods}"
                    SelectedItem="{Binding SelectedPeriod}"
                    Title="{ext:Localize SelectPeriod}"
                    FontSize="16"
                    MinimumHeightRequest="44"
                    HorizontalOptions="FillAndExpand"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"/>

            <!-- Custom Date Range Selector -->
            <VerticalStackLayout Spacing="12"
                                IsVisible="{Binding IsCustomPeriodSelected}">
                <Grid ColumnDefinitions="Auto,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="{ext:Localize From}"
                           FontSize="16"
                           VerticalOptions="Center"
                           MinimumWidthRequest="50"/>
                    <DatePicker Grid.Row="0" Grid.Column="1"
                               Date="{Binding CustomStartDate}"
                               Format="{x:Static helpers:DateFormatter.MediumPattern}"
                               FontSize="16"
                               MinimumHeightRequest="44"
                               HorizontalOptions="FillAndExpand"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"/>
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="{ext:Localize To}"
                           FontSize="16"
                           VerticalOptions="Center"
                           MinimumWidthRequest="50"/>
                    <DatePicker Grid.Row="1" Grid.Column="1"
                               Date="{Binding CustomEndDate}"
                               Format="{x:Static helpers:DateFormatter.MediumPattern}"
                               FontSize="16"
                               MinimumHeightRequest="44"
                               HorizontalOptions="FillAndExpand"
                               BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"/>
                </Grid>
            </VerticalStackLayout>

            <!-- Search, filters, grouping and sort -->
            <VerticalStackLayout Spacing="12">
                <!-- Search Bar -->
                <SearchBar Placeholder="{ext:Localize SearchTransactions}"
                           Text="{Binding Filters.SearchText}"
                           SearchCommand="{Binding Filters.SearchCommand}"
                           FontSize="14"
                           HeightRequest="44"
                           BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2D2D2D}"/>

                <!-- Filter Toggle + Active Filter Indicator -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="&#xF0234;"
                            FontFamily="MaterialDesignIcons"
                            Command="{Binding Filters.ToggleCommand}"
                            FontSize="20"
                            HeightRequest="44"
                            WidthRequest="44"
                            Padding="0"
                            CornerRadius="8"
                            BackgroundColor="{AppThemeBinding Light=#7B1FA2, Dark=#AB47BC}"
                            TextColor="White"/>
                    <Label Grid.Column="1"
                           IsVisible="{Binding HasActiveFilters}"
                           VerticalOptions="Center"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#7B1FA2, Dark=#CE93D8}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding FilteredCount}"/>
                                <Span Text=" / "/>
                                <Span Text="{Binding TotalCount}"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Button Grid.Column="2"
                            Text="{ext:Localize ClearFilters}"
                            IsVisible="{Binding HasActiveFilters}"
                            Command="{Binding Filters.ClearCommand}"
                            FontSize="13"
                            HeightRequest="36"
                            Padding="12,0"
                            CornerRadius="8"
                            BackgroundColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                            TextColor="White"/>
                </Grid>

                <!-- Filter Panel (Collapsible) -->
                <Frame IsVisible="{Binding Filters.IsVisible}"
                       BackgroundColor="{AppThemeBinding Light=#F3E5F5, Dark=#2A1A2E}"
                       BorderColor="{AppThemeBinding Light=#CE93D8, Dark=#7B1FA2}"
                       CornerRadius="10"
                       Padding="12"
                       HasShadow="False">
                    <VerticalStackLayout Spacing="10">
                        <!-- Type Filter -->
                        <Label Text="{ext:Localize FilterByType}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#4A148C, Dark=#CE93D8}"/>
                        <Picker ItemsSource="{Binding Filters.Types}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding Filters.SelectedType}"
                                FontSize="14"
                                MinimumHeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"/>

                        <!-- Category Filter -->
                        <Label Text="{ext:Localize FilterByCategory}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#4A148C, Dark=#CE93D8}"/>
                        <Picker ItemsSource="{Binding Filters.Categories}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding Filters.SelectedCategory}"
                                Title="{ext:Localize AllCategories}"
                                FontSize="14"
                                MinimumHeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"/>

                        <!-- Account Filter -->
                        <Label Text="{ext:Localize FilterByAccount}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#4A148C, Dark=#CE93D8}"/>
                        <Picker ItemsSource="{Binding Filters.Accounts}"
                                ItemDisplayBinding="{Binding Name}"
                                SelectedItem="{Binding Filters.SelectedAccount}"
                                Title="{ext:Localize AllAccounts}"
                                FontSize="14"
                                MinimumHeightRequest="40"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"/>

                        <!-- Amount Range -->
                        <Label Text="{ext:Localize AmountRange}"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#4A148C, Dark=#CE93D8}"/>
                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                            <Entry Grid.Column="0"
                                   Text="{Binding Filters.MinAmountText}"
                                   Placeholder="{ext:Localize Min}"
                                   Keyboard="Numeric"
                                   FontSize="14"
                                   HeightRequest="40"
                                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"/>
                            <Label Grid.Column="1"
                                   Text="—"
                                   VerticalOptions="Center"
                                   FontSize="14"/>
                            <Entry Grid.Column="2"
                                   Text="{Binding Filters.MaxAmountText}"
                                   Placeholder="{ext:Localize Max}"
                                   Keyboard="Numeric"
                                   FontSize="14"
                                   HeightRequest="40"
                                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"/>
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Grouping & Sort Buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Grid.Column="0"
                            Text="{Binding CurrentGroupingMode, Converter={StaticResource BoolToGroupTextConverter}}"
                            Command="{Binding ToggleGroupingCommand}"
                            HorizontalOptions="Fill"
                            FontSize="14"
                            Padding="8,10"
                            HeightRequest="44"
                            CornerRadius="8"
                            BackgroundColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}"
                            TextColor="White"/>
                    <Button Grid.Column="1"
                            Text="{Binding IsAscending, Converter={StaticResource BoolToSortTextConverter}}"
                            Command="{Binding ToggleSortOrderCommand}"
                            HorizontalOptions="Fill"
                            FontSize="14"
                            Padding="8,10"
                            HeightRequest="44"
                            CornerRadius="8"
                            BackgroundColor="{AppThemeBinding Light=#9E9E9E, Dark=#757575}"
                            TextColor="White"/>
                </Grid>
            </VerticalStackLayout>


            <!-- Ungrouped Transactions List -->
            <ContentView IsVisible="{Binding CurrentGroupingMode, Converter={StaticResource GroupingModeToIsNotGroupedConverter}}">
                <CollectionView ItemsSource="{Binding Transactions}">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center">
                            <Label Text="&#xF0127;" 
                                   FontFamily="MaterialDesignIcons"
                                   FontSize="48" 
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <Label Text="{ext:Localize NoTransactions}" 
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                            <Label Text="{ext:Localize StartTracking}" 
                                   FontSize="14"
                                   HorizontalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#999999, Dark=#888888}"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:LedgerEntry">
                            <Frame Margin="0,6"
                                   Padding="16"
                                   BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                   BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}"
                                   CornerRadius="12"
                                   HasShadow="False">
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
                                    <!-- Row 0: Date and Amount -->
                                    <Label Grid.Row="0" Grid.Column="0"
                                           Text="{Binding Date, Converter={StaticResource DateTextConverter}, ConverterParameter=Medium}"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                                    <Label Grid.Row="0" Grid.Column="1"
                                           Text="{Binding ., Converter={StaticResource TransactionAmountConverter}}"
                                           FontSize="22"
                                           FontAttributes="Bold"
                                           TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}"/>

                                    <!-- Row 1: Description -->
                                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           FontSize="17"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"/>

                                    <!-- Row 2: Category -->
                                    <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                        <Label Text="{Binding CategoryDisplayIcon}"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                        <Label Text="{Binding CategoryName}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                    </HorizontalStackLayout>

                                    <!-- Row 3: Account -->
                                    <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                        <Label Text="{Binding AccountDisplayIcon}" FontFamily="MaterialDesignIcons" FontSize="14" TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                        <Label Text="{Binding AccountDisplayName}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                    </HorizontalStackLayout>

                                    <!-- Row 4: Tags -->
                                    <HorizontalStackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                          Spacing="6"
                                                          IsVisible="{Binding HasTags}">
                                        <Label Text="&#xF04F9;"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}"/>
                                        <Label Text="{Binding Tags}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}"
                                               LineBreakMode="TailTruncation"/>
                                    </HorizontalStackLayout>

                                    <!-- Row 5: Receipt indicator -->
                                    <HorizontalStackLayout Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                                          Spacing="6"
                                                          IsVisible="{Binding HasReceipt}">
                                        <Label Text="&#xF0449;"
                                               FontFamily="MaterialDesignIcons"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"/>
                                        <Label Text="{ext:Localize ReceiptAttached}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"/>
                                    </HorizontalStackLayout>

                                    <!-- Row 6: Action Buttons -->
                                    <HorizontalStackLayout Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                                          Spacing="12"
                                                          HorizontalOptions="End"
                                                          Margin="0,8,0,0">
                                        <Button Text="{ext:Localize EditButton}"
                                                FontSize="14"
                                                HeightRequest="36"
                                                Padding="16,0"
                                                CornerRadius="8"
                                                BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"
                                                TextColor="White"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=EditTransactionCommand}"
                                                CommandParameter="{Binding .}"/>
                                        <Button Text="{ext:Localize DeleteButton}"
                                                FontSize="14"
                                                HeightRequest="36"
                                                Padding="16,0"
                                                CornerRadius="8"
                                                BackgroundColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                                                TextColor="White"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </HorizontalStackLayout>
                                </Grid>
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ContentView>




            <!-- Grouped Transactions List (Collapsible) -->
            <ContentView IsVisible="{Binding CurrentGroupingMode, Converter={StaticResource GroupingModeToIsGroupedConverter}}">
                <VerticalStackLayout>
                    <!-- Empty State -->
                    <VerticalStackLayout Padding="40" Spacing="12" HorizontalOptions="Center"
                                        IsVisible="{Binding HasTransactions, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="&#xF0127;" 
                               FontFamily="MaterialDesignIcons"
                               FontSize="48" 
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Label Text="{ext:Localize NoTransactions}" 
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"
                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                        <Label Text="{ext:Localize StartTracking}" 
                               FontSize="14"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#999999, Dark=#888888}"/>
                    </VerticalStackLayout>
                    
                    <!-- Collapsible Groups -->
                    <CollectionView ItemsSource="{Binding GroupedTransactions}"
                                   IsVisible="{Binding HasTransactions}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:TransactionGroup">
                                <VerticalStackLayout Margin="0,6">
                                    <!-- Group Header (Clickable) -->
                                    <Frame Padding="16"
                                           BackgroundColor="{AppThemeBinding Light=#E3F2FD, Dark=#0D47A1}"
                                           BorderColor="{AppThemeBinding Light=#2196F3, Dark=#64B5F6}"
                                           CornerRadius="12"
                                           HasShadow="False">
                                        <Frame.GestureRecognizers>
                                            <TapGestureRecognizer 
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=ToggleGroupExpandedCommand}"
                                                CommandParameter="{Binding .}"/>
                                        </Frame.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="4">
                                            <!-- Expand/Collapse Icon -->
                                            <Label Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                                   Text="{Binding IsExpanded, Converter={StaticResource BoolToExpandIconConverter}}"
                                                   FontFamily="MaterialDesignIcons"
                                                   FontSize="16"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}"/>
                                            
                                            <!-- Category/Group Icon -->
                                            <Label Grid.Row="0" Grid.Column="1" Grid.RowSpan="2"
                                                   Text="{Binding GroupDisplayIcon}"
                                                   FontFamily="MaterialDesignIcons"
                                                   FontSize="28"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                            
                                            <!-- Category Name -->
                                            <Label Grid.Row="0" Grid.Column="2"
                                                   Text="{Binding GroupName}"
                                                   FontSize="18"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light=#1565C0, Dark=#90CAF9}"/>
                                            
                                            <!-- Total Amount -->
                                            <Label Grid.Row="0" Grid.Column="3"
                                                   Text="{Binding ., Converter={StaticResource GroupTotalConverter}}"
                                                   FontSize="20"
                                                   FontAttributes="Bold"
                                                   VerticalOptions="Center"
                                                   TextColor="{Binding ., Converter={StaticResource GroupTypeToColorConverter}}"/>
                                            
                                            <!-- Transaction Count -->
                                            <Label Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                                   Text="{Binding TransactionCount, Converter={StaticResource TransactionCountConverter}}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                        </Grid>
                                    </Frame>
                                    
                                    
                                    <!-- Expanded Items -->
                                    <VerticalStackLayout IsVisible="{Binding IsExpanded}"
                                                        BindableLayout.ItemsSource="{Binding Items}"
                                                        Margin="16,0,0,0">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:LedgerEntry">
                                                <Frame Margin="0,6,0,0" 
                                                       Padding="14"
                                                       BorderColor="{AppThemeBinding Light=#E0E0E0, Dark=#404040}"
                                                       BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#252525}"
                                                       CornerRadius="10"
                                                       HasShadow="False">
                                                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                                                        <!-- Row 0: Date and Amount -->
                                                        <Label Grid.Row="0" Grid.Column="0"
                                                               Text="{Binding Date, Converter={StaticResource DateTextConverter}, ConverterParameter=Medium}"
                                                               FontSize="13"
                                                               TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>

                                                        <Label Grid.Row="0" Grid.Column="1"
                                                               Text="{Binding ., Converter={StaticResource TransactionAmountConverter}}"
                                                               FontSize="18"
                                                               FontAttributes="Bold"
                                                               TextColor="{Binding Type, Converter={StaticResource TransactionTypeToColorConverter}}"/>

                                                        <!-- Row 1: Description -->
                                                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                                               Text="{Binding Description}"
                                                               FontSize="15"
                                                               TextColor="{AppThemeBinding Light=#333333, Dark=#FFFFFF}"
                                                               LineBreakMode="TailTruncation"/>

                                                        <!-- Row 2: Category -->
                                                        <HorizontalStackLayout Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                                            <Label Text="{Binding CategoryDisplayIcon}"
                                                                   FontFamily="MaterialDesignIcons"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                                            <Label Text="{Binding CategoryName}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                                        </HorizontalStackLayout>

                                                        <!-- Row 3: Account -->
                                                        <HorizontalStackLayout Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6">
                                                            <Label Text="{Binding AccountDisplayIcon}" FontFamily="MaterialDesignIcons" FontSize="12" TextColor="{AppThemeBinding Light=#1976D2, Dark=#64B5F6}"/>
                                                            <Label Text="{Binding AccountDisplayName}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light=#666666, Dark=#AAAAAA}"/>
                                                        </HorizontalStackLayout>

                                                        <!-- Row 4: Tags -->
                                                        <HorizontalStackLayout Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                                                              Spacing="6"
                                                                              IsVisible="{Binding HasTags}">
                                                            <Label Text="&#xF04F9;"
                                                                   FontFamily="MaterialDesignIcons"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}"/>
                                                            <Label Text="{Binding Tags}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light=#FF9800, Dark=#FFB74D}"
                                                                   LineBreakMode="TailTruncation"/>
                                                        </HorizontalStackLayout>

                                                        <!-- Row 5: Receipt indicator -->
                                                        <HorizontalStackLayout Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2"
                                                                              Spacing="6"
                                                                              IsVisible="{Binding HasReceipt}">
                                                            <Label Text="&#xF0449;"
                                                                   FontFamily="MaterialDesignIcons"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"/>
                                                            <Label Text="{ext:Localize ReceiptAttached}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light=#4CAF50, Dark=#81C784}"/>
                                                        </HorizontalStackLayout>

                                                        <!-- Row 6: Action Buttons -->
                                                        <HorizontalStackLayout Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2"
                                                                              Spacing="10"
                                                                              HorizontalOptions="End"
                                                                              Margin="0,6,0,0">
                                                            <Button Text="{ext:Localize EditButton}"
                                                                    FontSize="13"
                                                                    HeightRequest="32"
                                                                    Padding="12,0"
                                                                    CornerRadius="6"
                                                                    BackgroundColor="{AppThemeBinding Light=#1976D2, Dark=#42A5F5}"
                                                                    TextColor="White"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=EditTransactionCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                            <Button Text="{ext:Localize DeleteButton}"
                                                                    FontSize="13"
                                                                    HeightRequest="32"
                                                                    Padding="12,0"
                                                                    CornerRadius="6"
                                                                    BackgroundColor="{AppThemeBinding Light=#D32F2F, Dark=#EF5350}"
                                                                    TextColor="White"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:TransactionsViewModel}}, Path=DeleteTransactionCommand}"
                                                                    CommandParameter="{Binding .}"/>
                                                        </HorizontalStackLayout>
                                                    </Grid>
                                                </Frame>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ContentView>


                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

                <!-- Loading Indicator Overlay -->
                <Grid IsVisible="{Binding IsRefreshing}"
                      BackgroundColor="{AppThemeBinding Light=#80FFFFFF, Dark=#80000000}">
                    <ActivityIndicator IsRunning="{Binding IsRefreshing}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Color="{AppThemeBinding Light=#4CAF50, Dark=#66BB6A}"
                                       HeightRequest="50"
                                       WidthRequest="50"/>
                </Grid>

        <controls:AddEntryButton x:Name="AddEntry" />
    </Grid>

</ContentPage>
